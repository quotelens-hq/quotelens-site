---
import '../styles/global.css'
import CookieConsent from '../components/CookieConsent.astro'
const props = Astro.props
const title = props.title ? props.title : 'QuoteLens — "How much?" finally has an answer.'
const description = props.description ? props.description : 'Instant quoting for fabricators and installers — curtains, doors, gates, kitchens. Your customers measure, choose materials, and get a real price in minutes — turning every ad click into a qualified lead.'
const url = 'https://quote-lens.app'
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>