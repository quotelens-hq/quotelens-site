---
const PAGE_TITLE = "Pricing — QuoteLens"
const PAGE_DESCRIPTION = "Simple, transparent pricing for publishing your interactive product catalogue with QuoteLens. Pay with M-Pesa, cancel anytime."
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <title>{PAGE_TITLE}</title>

    <meta
      name="description"
      content={PAGE_DESCRIPTION}
    />
  </head>

  <body>

    <main class="site">

      <!-- =====================================================
           NAVIGATION — same structure as the homepage. No
           "Pricing" link here either; this page is reached from
           the footer, per the same deliberate choice.
      ====================================================== -->

      <header class="site-header">

        <div class="header-inner">

          <a
            href="/"
            class="brand"
            aria-label="QuoteLens home"
          >
            <span class="brand-mark">Q</span>

            <span class="brand-name">
              QuoteLens
            </span>
          </a>


          <nav class="main-nav">

            <a href="/#catalogues">
              Catalogues
            </a>

            <a href="/#how-it-works">
              How it works
            </a>

            <a href="/#marketplace">
              Marketplace
            </a>

          </nav>


          <div style="display:flex; align-items:center; gap:18px;">

            <a href="/admin" class="signin-link">
              Sign In
            </a>

            <a
              href="/join"
              class="header-cta"
            >
              Publish your catalogue
            </a>

          </div>

        </div>

      </header>


      <!-- =====================================================
           PRICING
      ====================================================== -->

      <section class="pricing-hero">

        <div class="section-container">

          <div class="section-heading centered">

            <div>

              <div class="section-eyebrow">
                <span class="eyebrow-dot"></span>
                PRICING
              </div>

              <h1>
                Simple pricing.
                <br />
                Pay with M-Pesa.
              </h1>

            </div>

            <p>
              Two plans. No hidden fees. Cancel anytime.
            </p>

          </div>


          <div class="pricing-grid">

            <article class="pricing-card">

              <p class="pricing-plan-name">QuoteLens Starter</p>

              <p class="pricing-amount">
                KSh 2,500<span>/month</span>
              </p>

              <p class="pricing-usd">≈ $19 USD/month</p>

              <p class="pricing-tag">
                Perfect if you're running this yourself.
              </p>

              <ul class="pricing-features">
                <li>Your own quote page</li>
                <li>Limited AI-assisted measurements</li>
                <li>Unlimited customer quotes</li>
                <li>Marketplace listing</li>
                <li>WhatsApp &amp; email delivery</li>
                <li>Business dashboard</li>
                <li>Self-guided setup</li>
                <li>Standard support</li>
              </ul>

              <a href="/join" class="pricing-cta">
                <span>Get Started</span>
                <span>→</span>
              </a>

            </article>


            <article class="pricing-card featured">

              <p class="pricing-plan-name">QuoteLens Growth</p>

              <p class="pricing-amount">
                KSh 5,500<span>/month</span>
              </p>

              <p class="pricing-usd">≈ $42 USD/month</p>

              <p class="pricing-tag">
                For businesses handling higher volume.
              </p>

              <ul class="pricing-features">
                <li>Your own quote page</li>
                <li>Higher AI-assisted measurements</li>
                <li>Unlimited customer quotes</li>
                <li><strong>Priority</strong> Marketplace listing</li>
                <li>WhatsApp &amp; email delivery</li>
                <li>Business dashboard</li>
                <li>We personally set up your catalogue with you</li>
                <li><strong>Priority</strong> support</li>
              </ul>

              <a href="/join" class="pricing-cta">
                <span>Get Started</span>
                <span>→</span>
              </a>

            </article>

          </div>

          <p class="pricing-footnote">
            Pay with M-Pesa · Prices billed in KSh · Cancel anytime
          </p>

        </div>

      </section>


      <!-- =====================================================
           FOOTER — same structure as the homepage.
      ====================================================== -->

      <footer class="site-footer">

        <div class="footer-inner">

          <div class="footer-brand">

            <a
              href="/"
              class="brand"
            >

              <span class="brand-mark">
                Q
              </span>

              <span class="brand-name">
                QuoteLens
              </span>

            </a>


            <p>
              Discover. Configure. Compare. Enquire.
            </p>

          </div>


          <div class="footer-column">

            <strong>
              Explore
            </strong>

            <a href="/#catalogues">
              Catalogues
            </a>

            <a href="/#marketplace">
              Marketplace
            </a>

            <a href="/#how-it-works">
              How it works
            </a>

          </div>


          <div class="footer-column">

            <strong>
              Businesses
            </strong>

            <a href="/join">
              Publish a catalogue
            </a>

            <a href="/join">
              Join QuoteLens
            </a>

            <a href="/pricing">
              Pricing
            </a>

          </div>


          <div class="footer-column">

            <strong>
              QuoteLens
            </strong>

            <a href="/">
              About
            </a>

            <a href="/">
              Contact
            </a>

            <a href="/">
              Privacy
            </a>

          </div>

        </div>


        <div class="footer-bottom">

          <span>
            © {new Date().getFullYear()} QuoteLens
          </span>

          <span>
            Built for better buying conversations.
          </span>

        </div>

      </footer>

    </main>


    <!-- =====================================================
         PAGE STYLES — tokens, nav, footer copied directly from
         the homepage so this page matches exactly; pricing rules
         are the same block removed from the homepage body.
    ====================================================== -->

    <style>

      :root {

        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;

        color: #1a1916;

        background: #f7f4ef;

        --ink: #1a1916;
        --muted: #706a62;
        --soft: #9a9389;
        --line: #e5dfd6;
        --paper: #fffdf9;
        --cream: #f7f4ef;
        --gold: #b8862a;

      }


      * {
        box-sizing: border-box;
      }


      html {
        scroll-behavior: smooth;
      }


      body {
        margin: 0;
        background: var(--cream);
      }


      a {
        color: inherit;
      }


      button,
      input {
        font: inherit;
      }


      /* =====================================================
         HEADER
      ====================================================== */

      .site-header {

        position: sticky;

        top: 0;

        z-index: 50;

        background:
          rgba(247, 244, 239, .92);

        backdrop-filter:
          blur(18px);

        border-bottom:
          1px solid rgba(229, 223, 214, .85);

      }


      .header-inner {

        width:
          min(1180px, calc(100% - 48px));

        min-height: 72px;

        margin: 0 auto;

        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 30px;

      }


      .brand {

        display: inline-flex;

        align-items: center;

        gap: 10px;

        text-decoration: none;

        font-weight: 800;

        letter-spacing: -.025em;

      }


      .brand-mark {

        display: grid;

        place-items: center;

        width: 30px;

        height: 30px;

        border-radius: 8px;

        color: #fff;

        background: var(--ink);

        font-size: 14px;

      }


      .brand-name {
        font-size: 17px;
      }


      .main-nav {

        display: flex;

        align-items: center;

        gap: 30px;

        color: var(--muted);

        font-size: 13px;

        font-weight: 600;

      }


      .main-nav a {
        text-decoration: none;
      }


      .main-nav a:hover {
        color: var(--ink);
      }


      .signin-link {

        color: var(--muted);

        text-decoration: none;

        font-size: 13px;

        font-weight: 600;

      }


      .signin-link:hover {
        color: var(--ink);
      }


      .header-cta {

        padding:
          10px 16px;

        border:
          1px solid var(--ink);

        border-radius: 999px;

        background: var(--ink);

        color: #fff;

        text-decoration: none;

        font-size: 12px;

        font-weight: 700;

      }


      /* =====================================================
         GENERAL SECTIONS
      ====================================================== */

      .section-container {

        width:
          min(1180px, calc(100% - 48px));

        margin: 0 auto;

      }


      .section-heading.centered {

        display: grid;

        grid-template-columns:
          minmax(0, 800px);

        justify-content: center;

        text-align: center;

      }


      .section-heading.centered
      .section-eyebrow {

        justify-content: center;

      }


      .section-eyebrow {

        display: flex;

        align-items: center;

        gap: 9px;

        color: var(--gold);

        font-size: 11px;

        font-weight: 800;

        letter-spacing: .12em;

      }


      .eyebrow-dot {

        width: 7px;

        height: 7px;

        border-radius: 50%;

        background: var(--gold);

      }


      .pricing-hero h1 {

        max-width: 700px;

        margin: 16px auto 0;

        font-size:
          clamp(38px, 5vw, 60px);

        line-height: 1;

        letter-spacing: -.055em;

      }


      .section-heading p {

        margin: 14px 0 0;

        color: var(--muted);

        font-size: 15px;

        line-height: 1.7;

      }


      /* =====================================================
         PRICING
      ====================================================== */

      .pricing-hero {
        padding: 90px 0 110px;
      }

      .pricing-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
        max-width: 780px;
        margin: 56px auto 0;
      }

      .pricing-card {
        padding: 34px 28px;
        border: 1px solid var(--line);
        border-radius: 20px;
        background: #fff;
        transition: transform .2s ease, box-shadow .2s ease;
      }

      .pricing-card.featured {
        border-color: var(--ink);
        box-shadow: 0 18px 45px rgba(40,35,29,.08);
      }

      .pricing-card:hover {
        transform: translateY(-3px);
      }

      .pricing-plan-name {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
      }

      .pricing-amount {
        margin: 10px 0 0;
        font-size: 38px;
        font-weight: 800;
        letter-spacing: -.03em;
        color: var(--ink);
      }

      .pricing-amount span {
        font-size: 14px;
        font-weight: 600;
        color: var(--muted);
      }

      .pricing-usd {
        margin: 2px 0 0;
        color: var(--soft);
        font-size: 12px;
      }

      .pricing-tag {
        margin: 10px 0 0;
        color: var(--muted);
        font-size: 13px;
      }

      .pricing-features {
        list-style: none;
        margin: 24px 0 0;
        padding: 0;
      }

      .pricing-features li {
        padding: 9px 0;
        border-bottom: 1px solid var(--line);
        color: var(--muted);
        font-size: 13px;
      }

      .pricing-features li::before {
        content: "✓ ";
        color: var(--gold);
        font-weight: 800;
      }

      .pricing-cta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 24px;
        padding: 13px 16px;
        border-radius: 10px;
        background: var(--ink);
        color: #fff;
        text-decoration: none;
        font-size: 13px;
        font-weight: 800;
        transition: background .2s ease;
      }

      .pricing-cta:hover {
        background: var(--gold);
      }

      .pricing-footnote {
        margin-top: 26px;
        text-align: center;
        color: var(--soft);
        font-size: 12px;
      }


      /* =====================================================
         FOOTER
      ====================================================== */

      .site-footer {

        background: #1a1916;

        color: #fff;

      }


      .footer-inner {

        width:
          min(1180px, calc(100% - 48px));

        margin: 0 auto;

        padding:
          70px 0 55px;

        display: grid;

        grid-template-columns:
          2fr 1fr 1fr 1fr;

        gap: 50px;

      }


      .footer-brand p {

        margin-top: 17px;

        color: #88827a;

        font-size: 11px;

      }


      .footer-column {

        display: flex;

        flex-direction: column;

        gap: 11px;

      }


      .footer-column strong {

        margin-bottom: 5px;

        color: #fff;

        font-size: 11px;

      }


      .footer-column a {

        color: #89837b;

        text-decoration: none;

        font-size: 11px;

      }


      .footer-column a:hover {
        color: #fff;
      }


      .footer-bottom {

        width:
          min(1180px, calc(100% - 48px));

        margin: 0 auto;

        padding:
          20px 0;

        display: flex;

        justify-content: space-between;

        gap: 20px;

        border-top:
          1px solid rgba(255,255,255,.09);

        color: #706b64;

        font-size: 10px;

      }


      /* =====================================================
         RESPONSIVE
      ====================================================== */

      @media (max-width: 950px) {

        .footer-inner {

          grid-template-columns:
            2fr 1fr 1fr;

        }

      }


      @media (max-width: 700px) {

        .header-inner,
        .section-container,
        .footer-inner,
        .footer-bottom {

          width:
            min(100% - 30px, 1180px);

        }


        .main-nav {
          display: none;
        }


        .header-cta {
          font-size: 10px;
          padding: 9px 12px;
        }


        .pricing-hero {
          padding: 65px 0 75px;
        }


        .pricing-hero h1 {
          font-size: 40px;
        }


        .pricing-grid {
          grid-template-columns: 1fr;
        }


        .footer-inner {

          grid-template-columns:
            1fr 1fr;

        }


        .footer-brand {

          grid-column: 1 / -1;

        }


        .footer-bottom {

          flex-direction: column;

        }

      }

    </style>

  </body>
</html>
