---
const PAGE_TITLE = "Marketplace — QuoteLens"
const PAGE_DESCRIPTION = "Browse real, published product catalogues from businesses on QuoteLens."

const categories = [
  "All",
  "Food",
  "Fashion",
  "Home Improvement",
  "Furniture",
  "Automotive",
]
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{PAGE_TITLE}</title>
    <meta name="description" content={PAGE_DESCRIPTION} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>

  <body>

    <header class="site-header">
      <div class="nav-inner">
        <a href="/" class="brand" aria-label="QuoteLens home">
          <span class="brand-mark">Q</span>
          <span>QuoteLens</span>
        </a>
        <nav class="desktop-nav">
          <a href="/#catalogues">Catalogues</a>
          <a href="/#how-it-works">How it works</a>
          <a href="/marketplace">Marketplace</a>
        </nav>
        <div class="nav-actions">
          <a href="/admin" class="signin-link">Sign in</a>
          <a href="/join" class="nav-cta">Publish your catalogue</a>
        </div>
      </div>
    </header>

    <main>

      <section class="marketplace-hero">
        <div class="section-container">
          <div class="eyebrow">
            <span class="eyebrow-dot"></span>
            MARKETPLACE
          </div>
          <h1>Find something that fits.</h1>
          <p>Browse real, published catalogues from businesses on QuoteLens.</p>

          <div class="search-bar">
            <span>⌕</span>
            <input
              type="search"
              id="marketplace-search"
              placeholder="Search products, categories or businesses..."
              aria-label="Search marketplace"
            />
          </div>

          <div class="category-filter">
            {categories.map((category, index) => (
              <button
                type="button"
                class:list={{ "category-button": true, active: index === 0 }}
                data-category={category}
              >
                {category}
              </button>
            ))}
          </div>
        </div>
      </section>

      <section class="marketplace-results">
        <div class="section-container">

          <div id="marketplace-status" class="status-text">
            Loading published catalogues...
          </div>

          <div id="marketplace-empty" class="status-text" style="display:none;">
            No businesses have published a catalogue yet.
            <a href="/join">Publish your catalogue →</a>
          </div>

          <div id="no-results" class="status-text" style="display:none;">
            Nothing matched your search or filter.
          </div>

          <div class="marketplace-grid" data-marketplace-grid></div>

          <div class="load-more-wrap">
            <button id="load-more-btn" class="button button-dark" style="display:none;">
              Load more
            </button>
            <p id="results-count" class="results-count"></p>
          </div>

        </div>
      </section>

    </main>

    <footer class="site-footer">
      <div class="section-container">
        <div class="footer-main">
          <div class="footer-brand">
            <a href="/" class="brand footer-logo">
              <span class="brand-mark">Q</span>
              <span>QuoteLens</span>
            </a>
            <p>Specification-driven buying for custom and made-to-order products.</p>
          </div>
          <div class="footer-links">
            <div>
              <span>EXPLORE</span>
              <a href="/#catalogues">Catalogues</a>
              <a href="/#how-it-works">How it works</a>
              <a href="/marketplace">Marketplace</a>
            </div>
            <div>
              <span>FOR BUSINESSES</span>
              <a href="/join">Publish</a>
              <a href="/admin">Sign in</a>
              <a href="/pricing">Pricing</a>
            </div>
            <div>
              <span>COMMUNITY</span>
              <a href="/community">Community</a>
              <a href="/help">Help</a>
            </div>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} QuoteLens</span>
          <span>Built for better buying conversations.</span>
        </div>
      </div>
    </footer>

    <script>
      import { supabase } from '../utils/supabase.js'

      // ── Real limitation, named honestly ──────────────────────
      // marketplace_listing is one JSONB blob per tenant, not one
      // row per product — so we can't ask Postgres for "just page
      // 3" directly. We fetch every real listing ONCE, flatten
      // into individual cards, then reveal them in batches here.
      // This solves the DOM/scroll problem (never rendering
      // thousands of cards at once) but not the query-payload
      // problem at true scale — a dedicated products table (one
      // row per product) would be the real fix for that, later.

      const BATCH_SIZE = 30
      const SHOWROOM_TENANT_ID = 'showroom'

      // Plantation Shutters is the priority catalogue right now —
      // its cards should surface first (and stay first through
      // search/category filtering), ahead of every other template.
      const PRIORITY_TEMPLATE_ID = 'plantation_shutters'

      const CATEGORY_META = {
        cakes:                { category: 'Food',              icon: '🎂' },
        flowers:               { category: 'Food',              icon: '💐' },
        womens_dresses:         { category: 'Fashion',           icon: '👗' },
        vehicle_parts:          { category: 'Automotive',        icon: '🔧' },
        plantation_shutters:    { category: 'Home Improvement',  icon: '🪟' },
        curtains:               { category: 'Home Improvement',  icon: '🪟' },
        wooden_doors:           { category: 'Home Improvement',  icon: '🚪' },
        steel_doors:            { category: 'Home Improvement',  icon: '🛡️' },
        gates:                  { category: 'Home Improvement',  icon: '🚪' },
        garage_doors:           { category: 'Home Improvement',  icon: '🚗' },
        kitchen_island:         { category: 'Furniture',         icon: '🍽️' },
        blinds:                 { category: 'Home Improvement',  icon: '🪟' }
      }

      function formatDimension(dimension) {
        if (!dimension || dimension.arg1 == null || dimension.arg2 == null) return null
        const widthM = (Number(dimension.arg1) / 1000).toFixed(2)
        const heightM = (Number(dimension.arg2) / 1000).toFixed(2)
        return `${widthM}m × ${heightM}m`
      }

      // Stable sort — plantation_shutters cards float to the top,
      // everything else keeps its existing relative order behind
      // them. Applied once right after allCards is built, so the
      // initial grid, every search, and every category filter all
      // inherit the same priority ordering automatically (filter
      // preserves relative order of an already-sorted array).
      function byPlantationShuttersFirst(a, b) {
        const aRank = a.templateId === PRIORITY_TEMPLATE_ID ? 0 : 1
        const bRank = b.templateId === PRIORITY_TEMPLATE_ID ? 0 : 1
        return aRank - bRank
      }

      let allCards = []
      let filteredCards = []
      let visibleCount = BATCH_SIZE
      let activeCategory = 'All'

      async function loadMarketplace() {
        const statusEl = document.getElementById('marketplace-status')
        const emptyEl = document.getElementById('marketplace-empty')

        const { data: tenants, error } = await supabase
          .from('tenant_config')
          .select('tenant_id, business_name, currency_symbol, marketplace_listing')
          .eq('subscription_status', 'active')
          .eq('marketplace_listed', true)
          .not('marketplace_listing', 'is', null)

        if (error) {
          statusEl.textContent = 'Could not load the marketplace right now.'
          console.error(error)
          return
        }

        ;(tenants || []).forEach((tenant) => {
          const listingsByTemplate = tenant.marketplace_listing
          if (!listingsByTemplate || typeof listingsByTemplate !== 'object') return
          const isShowroom = tenant.tenant_id === SHOWROOM_TENANT_ID

          Object.entries(listingsByTemplate).forEach(([templateId, listing]) => {
            if (!listing?.cards?.length) return
            const meta = CATEGORY_META[templateId] || { category: 'Other', icon: '📦' }
            const dimensionLabel = formatDimension(listing.dimension)

            listing.cards.forEach((card) => {
              if (!card.imageUrl) return
              allCards.push({
                tenantId: tenant.tenant_id,
                templateId,
                businessName: tenant.business_name,
                currencySymbol: tenant.currency_symbol || 'KSh',
                material: card.material?.label || '',
                spec: card.spec?.label || '',
                price: card.price,
                imageUrl: card.imageUrl,
                dimensionLabel,
                category: meta.category,
                icon: meta.icon,
                isShowroom,
                searchText: (tenant.business_name + ' ' + (card.material?.label || '') + ' ' + (card.spec?.label || '')).toLowerCase()
              })
            })
          })
        })

        allCards.sort(byPlantationShuttersFirst)

        statusEl.style.display = 'none'

        if (allCards.length === 0) {
          emptyEl.style.display = 'block'
          return
        }

        applyFilters()
      }

      function applyFilters() {
        const query = document.getElementById('marketplace-search').value.toLowerCase().trim()

        filteredCards = allCards.filter((card) => {
          const matchesCategory = activeCategory === 'All' || card.category === activeCategory
          const matchesSearch = !query || card.searchText.includes(query)
          return matchesCategory && matchesSearch
        })

        visibleCount = BATCH_SIZE
        renderGrid()
      }

      function renderGrid() {
        const gridEl = document.querySelector('[data-marketplace-grid]')
        const noResultsEl = document.getElementById('no-results')
        const loadMoreBtn = document.getElementById('load-more-btn')
        const resultsCount = document.getElementById('results-count')

        if (filteredCards.length === 0) {
          gridEl.innerHTML = ''
          noResultsEl.style.display = 'block'
          loadMoreBtn.style.display = 'none'
          resultsCount.textContent = ''
          return
        }

        noResultsEl.style.display = 'none'

        const visible = filteredCards.slice(0, visibleCount)

        gridEl.innerHTML = visible.map((card) => `
          <a href="https://quote-lens.app/t/${card.tenantId}" class="marketplace-card">
            <img src="${card.imageUrl}" alt="${card.material} ${card.spec}" loading="lazy" />
            <div class="marketplace-card-body">
              <span class="business-name">
                ${card.businessName}${card.isShowroom ? ' · DEMO' : ''}
              </span>
              ${card.dimensionLabel ? `<span class="dimension">${card.dimensionLabel}</span>` : ''}
              <strong>${card.material}</strong>
              <span class="spec">${card.spec}</span>
              <span class="price">${card.currencySymbol} ${Number(card.price).toLocaleString()}</span>
            </div>
          </a>
        `).join('')

        resultsCount.textContent = `Showing ${visible.length} of ${filteredCards.length}`
        loadMoreBtn.style.display = visibleCount < filteredCards.length ? 'inline-flex' : 'none'
      }

      document.getElementById('marketplace-search')?.addEventListener('input', applyFilters)

      document.querySelectorAll('[data-category]').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('[data-category]').forEach(b => b.classList.remove('active'))
          btn.classList.add('active')
          activeCategory = btn.getAttribute('data-category')
          applyFilters()
        })
      })

      document.getElementById('load-more-btn')?.addEventListener('click', () => {
        visibleCount += BATCH_SIZE
        renderGrid()
      })

      loadMarketplace()
    </script>

    <style>

      :global(*) { box-sizing: border-box; }
      :global(html) { scroll-behavior: smooth; }
      :global(body) {
        margin: 0; background: #f7f4ed; color: #181714;
        font-family: "Manrope", sans-serif; -webkit-font-smoothing: antialiased;
      }
      :global(a) { color: inherit; text-decoration: none; }
      :global(button), :global(input) { font: inherit; }
      :global(button) { cursor: pointer; }

      .section-container { width: min(1180px, calc(100% - 80px)); margin: 0 auto; }

      .site-header {
        position: sticky; top: 0; z-index: 50;
        background: rgba(247, 244, 237, 0.92); backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(24, 23, 20, 0.09);
      }
      .nav-inner {
        width: min(1180px, calc(100% - 80px)); height: 70px; margin: 0 auto;
        display: flex; align-items: center; justify-content: space-between; gap: 30px;
      }
      .brand { display: inline-flex; align-items: center; gap: 10px; font-size: 17px; font-weight: 800; letter-spacing: -0.04em; }
      .brand-mark { width: 30px; height: 30px; display: grid; place-items: center; border-radius: 8px; background: #181714; color: #fff; font-size: 13px; font-weight: 800; }
      .desktop-nav { display: flex; align-items: center; gap: 34px; margin-left: auto; margin-right: auto; }
      .desktop-nav a, .signin-link { color: #68645d; font-size: 13px; font-weight: 600; }
      .desktop-nav a:hover, .signin-link:hover { color: #181714; }
      .nav-actions { display: flex; align-items: center; gap: 20px; }
      .nav-cta { padding: 12px 18px; border-radius: 999px; background: #181714; color: white; font-size: 12px; font-weight: 800; }
      .nav-cta:hover { background: #2b2924; }

      .eyebrow { display: flex; align-items: center; gap: 9px; color: #b27c19; font-size: 11px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; }
      .eyebrow-dot { width: 6px; height: 6px; border-radius: 50%; background: #b27c19; }

      .marketplace-hero { padding: 70px 0 40px; text-align: center; }
      .marketplace-hero h1 {
        margin: 16px 0 10px; font-size: clamp(38px, 5vw, 60px);
        line-height: 1; letter-spacing: -0.06em;
      }
      .marketplace-hero > .section-container > p {
        margin: 0 auto 34px; max-width: 480px; color: #736c63; font-size: 15px;
      }

      .search-bar {
        max-width: 560px; margin: 0 auto 20px;
        display: flex; align-items: center; gap: 12px;
        padding: 15px 18px; border: 1px solid #ddd6cb; border-radius: 14px; background: #fff;
      }
      .search-bar span { color: #938b81; font-size: 18px; }
      .search-bar input { flex: 1; border: 0; outline: 0; background: transparent; font-size: 14px; }

      .category-filter { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
      .category-button {
        padding: 9px 16px; border: 1px solid #ded7cd; border-radius: 999px;
        background: transparent; color: #716a61; font-size: 11px; font-weight: 700;
      }
      .category-button.active, .category-button:hover { border-color: #181714; background: #181714; color: white; }

      .marketplace-results { padding: 20px 0 100px; }
      .status-text { text-align: center; padding: 40px 0; color: #756e65; font-size: 13px; }
      .status-text a { display: block; margin-top: 6px; color: #181714; font-weight: 800; }

      :global(.marketplace-grid) {
        display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-top: 10px;
      }
      :global(.marketplace-card) {
        display: block; overflow: hidden; border: 1px solid #e0d9cf; border-radius: 16px;
        background: #fff; transition: transform 0.2s ease, box-shadow 0.2s ease;
      }
      :global(.marketplace-card:hover) { transform: translateY(-3px); box-shadow: 0 15px 35px rgba(40,35,29,.08); }
      :global(.marketplace-card img) { width: 100%; height: 160px; object-fit: cover; display: block; }
      :global(.marketplace-card-body) { padding: 16px; display: flex; flex-direction: column; gap: 3px; }
      :global(.business-name) {
        color: #b27c19; font-size: 8px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
      }
      :global(.marketplace-card .dimension) { color: #9b9389; font-size: 10px; }
      :global(.marketplace-card strong) { font-size: 15px; letter-spacing: -0.02em; margin-top: 3px; }
      :global(.marketplace-card .spec) { color: #756e65; font-size: 11px; }
      :global(.marketplace-card .price) { color: #181714; font-weight: 800; font-size: 14px; margin-top: 4px; }

      .load-more-wrap { text-align: center; margin-top: 40px; }
      .button {
        min-height: 46px; padding: 0 22px; display: inline-flex; align-items: center; justify-content: center;
        border-radius: 999px; font-size: 13px; font-weight: 800;
      }
      .button-dark { background: #181714; color: white; }
      .button-dark:hover { background: #292823; }
      .results-count { margin-top: 12px; color: #9b9389; font-size: 11px; }

      .site-footer { padding: 70px 0 25px; background: #181714; color: white; }
      .footer-main { display: grid; grid-template-columns: 1fr 1fr; gap: 100px; }
      .footer-logo { color: white; }
      .footer-brand p { max-width: 310px; margin-top: 20px; color: #77736c; font-size: 12px; line-height: 1.7; }
      .footer-links { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
      .footer-links > div { display: flex; flex-direction: column; gap: 12px; }
      .footer-links span { margin-bottom: 6px; color: #77736c; font-size: 9px; font-weight: 800; letter-spacing: 0.1em; }
      .footer-links a { color: #c2beb8; font-size: 11px; }
      .footer-links a:hover { color: white; }
      .footer-bottom {
        display: flex; justify-content: space-between; margin-top: 70px; padding-top: 20px;
        border-top: 1px solid #37352f; color: #68645d; font-size: 9px;
      }

      @media (max-width: 900px) {
        .nav-inner, .section-container { width: min(100% - 40px, 700px); }
        .desktop-nav { display: none; }
        :global(.marketplace-grid) { grid-template-columns: repeat(2, 1fr); }
        .footer-main { grid-template-columns: 1fr; gap: 40px; }
      }

      @media (max-width: 600px) {
        .nav-inner, .section-container { width: calc(100% - 30px); }
        .signin-link { display: none; }
        :global(.marketplace-grid) { grid-template-columns: 1fr; }
        .footer-links { grid-template-columns: 1fr 1fr; }
        .footer-bottom { flex-direction: column; gap: 8px; }
      }

    </style>

  </body>
</html>
