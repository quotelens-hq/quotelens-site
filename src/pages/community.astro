---
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Community — QuoteLens</title>
    <meta name="description" content="See how businesses are using QuoteLens to publish catalogues and turn conversations into orders." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>

  <body>
    <header class="site-header">
      <div class="nav-inner">
        <a href="/" class="brand" aria-label="QuoteLens home">
          <span class="brand-mark">Q</span>
          <span>QuoteLens</span>
        </a>
        <div class="nav-actions">
          <a href="/admin" class="signin-link">Sign in</a>
          <a href="/join" class="nav-cta">Publish your catalogue</a>
        </div>
      </div>
    </header>

    <main>
      <section class="community-hero">
        <span class="eyebrow">
          <span class="eyebrow-dot"></span>
          COMMUNITY
        </span>
        <h1>Built with early businesses,<br />not just for them.</h1>
        <p class="hero-sub">
          QuoteLens is early. That means the businesses publishing catalogues
          right now are shaping what this becomes — and we'd rather show you
          where things actually stand than dress it up with quotes nobody said.
        </p>
      </section>

      <section class="status-section">
        <div class="status-card">
          <span class="status-label">WHERE WE ARE TODAY</span>
          <p>
            We're in early access. A handful of businesses across cakes,
            flowers, home improvement, fashion, and automotive parts have
            published catalogues on QuoteLens. We don't have a wall of
            customer quotes to show you yet — and we're not going to
            invent any. This page will fill in with real feedback as
            businesses give us permission to share it.
          </p>
        </div>
      </section>

      <section class="testimonial-section">
        <h2>What we're hearing (so far)</h2>
        <div class="testimonial-placeholder">
          <p class="placeholder-title">This section is reserved for real feedback.</p>
          <p class="placeholder-body">
            If you're publishing a catalogue on QuoteLens and have a minute
            to share what's working (or not), reply to your onboarding
            email or reach out through <a href="/help">Help</a>. With your
            permission, we'll feature your story here — with your name and
            business, not as an anonymous quote.
          </p>
        </div>
      </section>

      <section class="why-section">
        <h2>Why businesses are trying it</h2>
        <div class="why-grid">
          <div class="why-item">
            <span class="why-index">01</span>
            <h3>No back-and-forth on specs</h3>
            <p>Customers configure exactly what they want before a conversation starts, so enquiries arrive with the details already attached.</p>
          </div>
          <div class="why-item">
            <span class="why-index">02</span>
            <h3>One link, everywhere</h3>
            <p>The same catalogue link works on Instagram, WhatsApp, TikTok, or a website — no separate setup per channel.</p>
          </div>
          <div class="why-item">
            <span class="why-index">03</span>
            <h3>Free to start</h3>
            <p>Every account publishes on the Starter plan at no cost, so trying it isn't a financial decision.</p>
          </div>
        </div>
      </section>

      <section class="cta-section">
        <h2>Want to be one of the first stories on this page?</h2>
        <p>Publish your catalogue, tell us how it goes, and — if you're happy to — let us share it here.</p>
        <a href="/join" class="cta-btn">Publish your catalogue free →</a>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-main">
          <div class="footer-brand">
            <a href="/" class="brand" aria-label="QuoteLens home">
              <span class="brand-mark">Q</span>
              <span>QuoteLens</span>
            </a>
            <p>Specification-driven buying for custom and made-to-order products.</p>
          </div>
          <div class="footer-links">
            <div>
              <span>EXPLORE</span>
              <a href="/">Home</a>
              <a href="/marketplace">Marketplace</a>
            </div>
            <div>
              <span>FOR BUSINESSES</span>
              <a href="/join">Publish</a>
              <a href="/admin">Sign in</a>
              <a href="/pricing">Pricing</a>
            </div>
            <div>
              <span>COMMUNITY</span>
              <a href="/community">Community</a>
              <a href="/help">Help</a>
            </div>
            <div>
              <span>LEGAL</span>
              <a href="/privacy">Privacy</a>
              <a href="/terms">Terms</a>
              <a href="/cookies">Cookies</a>
              <a href="/refunds">Refunds</a>
            </div>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} QuoteLens</span>
          <span>Built for better buying conversations.</span>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(html) {
    scroll-behavior: smooth;
    background: #f5f2eb;
  }

  :global(body) {
    margin: 0;
    background:
      radial-gradient(
        circle at 72% 8%,
        rgba(184, 134, 42, 0.055),
        transparent 28rem
      ),
      #f5f2eb;
    color: #191815;
    font-family: "Manrope", sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  :global(:root) {
    --ink: #191815;
    --ink-soft: #37342f;
    --muted: #756f66;
    --soft: #969087;

    --paper: #f5f2eb;
    --surface: #fffdfa;
    --white: #ffffff;

    --line: rgba(25, 24, 21, 0.095);
    --line-strong: rgba(25, 24, 21, 0.14);

    --gold: #b8862a;
    --gold-soft: #d4ad65;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;

    background: rgba(245, 242, 235, 0.84);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);

    border-bottom: 1px solid rgba(25, 24, 21, 0.075);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;

    max-width: 1180px;
    margin: 0 auto;
    padding: 16px 32px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;

    font-size: 16px;
    font-weight: 800;
    letter-spacing: -0.045em;
  }

  .brand-mark {
    width: 31px;
    height: 31px;

    display: grid;
    place-items: center;

    border-radius: 9px;

    background: var(--ink);
    color: white;

    font-size: 14px;
    font-weight: 800;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .signin-link {
    color: #68635b;

    font-size: 12px;
    font-weight: 650;

    transition: color 0.2s ease;
  }

  .signin-link:hover {
    color: var(--ink);
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;

    min-height: 40px;
    padding: 0 17px;

    border-radius: 999px;

    background: var(--ink);
    color: white;

    font-size: 12px;
    font-weight: 700;

    transition: background 0.2s ease;
  }

  .nav-cta:hover {
    background: var(--gold);
  }

  main {
    max-width: 760px;
    margin: 0 auto;
    padding: 80px 32px 100px;
  }

  .community-hero {
    text-align: center;
    margin-bottom: 56px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;

    color: var(--gold);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .12em;
  }

  .eyebrow-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gold);
  }

  .community-hero h1 {
    margin: 16px 0 0;
    font-size: clamp(32px, 6vw, 46px);
    line-height: 1.05;
    letter-spacing: -.04em;
    font-weight: 800;
  }

  .hero-sub {
    max-width: 560px;
    margin: 18px auto 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.7;
  }

  .status-section {
    margin-bottom: 56px;
  }

  .status-card {
    border: 1px solid var(--line-strong);
    border-radius: 20px;
    background: var(--surface);
    padding: 28px 30px;
    box-shadow: 0 18px 50px rgba(25, 24, 21, 0.06);
  }

  .status-label {
    display: block;
    color: var(--gold);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .status-card p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 14px;
    line-height: 1.75;
  }

  .testimonial-section {
    margin-bottom: 56px;
  }

  .testimonial-section h2,
  .why-section h2 {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -.02em;
    margin: 0 0 18px;
  }

  .testimonial-placeholder {
    border: 1px dashed var(--line-strong);
    border-radius: 18px;
    padding: 26px 28px;
  }

  .placeholder-title {
    margin: 0 0 8px;
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
  }

  .placeholder-body {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.75;
  }

  .placeholder-body a {
    color: var(--gold);
    font-weight: 700;
    text-decoration: underline;
  }

  .why-section {
    margin-bottom: 56px;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .why-item {
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 22px 20px;
    background: var(--surface);
  }

  .why-index {
    display: block;
    color: var(--gold-soft);
    font-size: 12px;
    font-weight: 800;
    margin-bottom: 10px;
  }

  .why-item h3 {
    margin: 0 0 8px;
    font-size: 14px;
    font-weight: 700;
  }

  .why-item p {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.65;
  }

  .cta-section {
    text-align: center;
    border-top: 1px solid var(--line);
    padding-top: 48px;
  }

  .cta-section h2 {
    margin: 0 0 10px;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -.02em;
  }

  .cta-section p {
    margin: 0 0 22px;
    color: var(--muted);
    font-size: 14px;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;

    padding: 13px 22px;
    border-radius: 999px;

    background: var(--ink);
    color: white;

    font-size: 13px;
    font-weight: 700;

    transition: background 0.2s ease;
  }

  .cta-btn:hover {
    background: var(--gold);
  }

  .site-footer {
    padding: 72px 0 25px;
    background: var(--ink);
    color: white;
  }

  .footer-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .footer-main {
    display: grid;
    grid-template-columns: 1.2fr 2fr;
    gap: 40px;
    margin-bottom: 40px;
  }

  .footer-brand p {
    margin: 14px 0 0;
    color: #ada89f;
    font-size: 13px;
    line-height: 1.7;
    max-width: 260px;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
  }

  .footer-links > div {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links span {
    margin-bottom: 7px;
    color: #6f6a62;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.14em;
  }

  .footer-links a {
    color: #bdb8b0;
    font-size: 10px;
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: white;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    margin-top: 65px;
    padding-top: 19px;
    border-top: 1px solid rgba(255,255,255,0.09);
    color: #666159;
    font-size: 11px;
  }

  @media (max-width: 900px) {
    .footer-main {
      grid-template-columns: 1fr;
    }
    .footer-links {
      grid-template-columns: repeat(2, 1fr);
    }
    .why-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .nav-inner {
      padding: 14px 20px;
    }
    main {
      padding: 56px 20px 72px;
    }
    .status-card {
      padding: 22px 20px;
    }
  }
</style>
