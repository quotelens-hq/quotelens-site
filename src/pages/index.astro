---
import { catalogues } from "../data/catalogues";

const categories = [
  "All",
  "Food",
  "Fashion",
  "Home Improvement",
  "Furniture",
  "Automotive",
];

const howItWorks = [
  {
    number: "01",
    title: "Discover",
    text: "Find a product or business that offers what you're looking for.",
  },
  {
    number: "02",
    title: "Configure",
    text: "Give the information needed to understand your requirements.",
  },
  {
    number: "03",
    title: "Compare",
    text: "Browse the products and options that match what you told us.",
  },
  {
    number: "04",
    title: "Enquire",
    text: "Choose what you want and send the business a prepared enquiry.",
  },
];

const marketplacePreview = [
  {
    category: "Home Improvement",
    icon: "🪟",
    title: "Plantation Shutters",
    business: "Kui's Plantation Shutters",
    description: "Configure your window requirements and compare available options.",
    action: "Configure product",
  },
  {
    category: "Automotive",
    icon: "🔧",
    title: "Vehicle Parts",
    business: "Published business catalogue",
    description: "Match a vehicle, model and part before starting the conversation.",
    action: "Match a part",
  },
  {
    category: "Food",
    icon: "🎂",
    title: "Custom Cakes",
    business: "Published business catalogue",
    description: "Choose an occasion, explore designs and prepare your enquiry.",
    action: "Explore options",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>
      QuoteLens — Specification-driven buying for custom products
    </title>

    <meta
      name="description"
      content="QuoteLens brings specification-driven buying to the fragmented world of custom and made-to-order products."
    />

    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />

    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>

    <!-- =====================================================
         NAVIGATION
    ====================================================== -->

    <header class="site-header">

      <div class="nav-inner">

        <a
          href="/"
          class="brand"
          aria-label="QuoteLens home"
        >
          <span class="brand-mark">
            Q
          </span>

          <span>
            QuoteLens
          </span>
        </a>


        <nav class="desktop-nav">

          <a href="#catalogues">
            Catalogues
          </a>

          <a href="#how-it-works">
            How it works
          </a>

          <a href="#marketplace">
            Marketplace
          </a>

        </nav>


        <div class="nav-actions">

          <a
            href="/signin"
            class="signin-link"
          >
            Sign in
          </a>

          <a
            href="/join"
            class="nav-cta"
          >
            Publish your catalogue
          </a>

        </div>

      </div>

    </header>


    <main>

      <!-- =====================================================
           HERO
      ====================================================== -->

      <section class="hero">

        <div class="hero-inner">

          <div class="hero-copy">

            <div class="eyebrow">
              <span class="eyebrow-dot"></span>
              Specification-driven buying
            </div>

            <h1>
              Know what
              <span>you want.</span>
              <strong>
                Know what it costs.
              </strong>
            </h1>

            <p class="hero-description">
              QuoteLens brings specification-driven buying
              to the fragmented world of custom and
              made-to-order products.
            </p>

            <div class="hero-actions">

              <a
                href="#catalogues"
                class="button button-dark"
              >
                <span>
                  Explore products
                </span>

                <span>
                  →
                </span>
              </a>

              <a
                href="/join"
                class="button button-light"
              >
                Publish your catalogue
              </a>

            </div>

            <div class="hero-note">
              Built for products that require customer
              specifications before purchase.
            </div>

          </div>


          <!-- HERO PRODUCT EXPERIENCE -->

          <div class="hero-experience">

            <div class="experience-window">

              <div class="window-bar">

                <div class="window-dots">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>

                <span>
                  QuoteLens
                </span>

              </div>


              <div class="experience-content">

                <div class="experience-label">
                  CUSTOMER JOURNEY
                </div>

                <h2>
                  Find something
                  <br />
                  that fits.
                </h2>


                <div class="journey-progress">

                  <div class="journey-step active">
                    <small>01</small>
                    <span>Discover</span>
                  </div>

                  <div class="journey-line"></div>

                  <div class="journey-step">
                    <small>02</small>
                    <span>Configure</span>
                  </div>

                  <div class="journey-line"></div>

                  <div class="journey-step">
                    <small>03</small>
                    <span>Compare</span>
                  </div>

                  <div class="journey-line"></div>

                  <div class="journey-step">
                    <small>04</small>
                    <span>Enquire</span>
                  </div>

                </div>


                <div class="experience-product">

                  <div class="product-icon">
                    🪟
                  </div>

                  <div class="product-details">

                    <span>
                      HOME IMPROVEMENT
                    </span>

                    <strong>
                      Plantation Shutters
                    </strong>

                    <p>
                      Configure your options
                    </p>

                  </div>

                  <span class="product-arrow">
                    →
                  </span>

                </div>


                <div class="experience-specs">

                  <div>
                    <small>
                      DIMENSION
                    </small>

                    <strong>
                      1,500 × 1,200
                    </strong>
                  </div>

                  <div>
                    <small>
                      MATERIAL
                    </small>

                    <strong>
                      Cypress
                    </strong>
                  </div>

                  <div>
                    <small>
                      FINISH
                    </small>

                    <strong>
                      Painted
                    </strong>
                  </div>

                </div>

              </div>

            </div>

          </div>

        </div>

      </section>


      <!-- =====================================================
           QUOTELENS THESIS
      ====================================================== -->

      <section class="thesis">

        <div class="section-container">

          <div class="section-eyebrow">
            THE QUOTELENS IDEA
          </div>

          <div class="thesis-grid">

            <h2>
              Specification-driven buying
              <span>
                for products that don't
                come off a shelf.
              </span>
            </h2>

            <div class="thesis-copy">

              <p>
                Custom buying traditionally starts with
                an explanation and ends with a conversation
                about price.
              </p>

              <div class="comparison">

                <div class="comparison-row">

                  <span>
                    Traditional custom buying
                  </span>

                  <strong>
                    Explain → Measure → Discuss → Quote → Revise
                  </strong>

                </div>

                <div class="comparison-row highlight">

                  <span>
                    QuoteLens
                  </span>

                  <strong>
                    Specify → Discover → Compare → Enquire
                  </strong>

                </div>

              </div>

            </div>

          </div>

        </div>

      </section>


      <!-- =====================================================
           CATALOGUES
      ====================================================== -->

      <section
        id="catalogues"
        class="catalogues-section"
      >

        <div class="section-container">

          <div class="catalogue-heading">

            <div>

              <div class="section-eyebrow">
                EXPLORE CATALOGUES
              </div>

              <h2>
                Start with what you're
                <br />
                looking for.
              </h2>

            </div>

            <p>
              Interactive catalogues turn complicated
              custom products into guided buying experiences.
            </p>

          </div>


          <!-- SEARCH -->

          <div class="catalogue-search">

            <span class="search-icon">
              ⌕
            </span>

            <input
              type="search"
              id="catalogue-search"
              placeholder="Search products, categories or catalogues..."
              aria-label="Search catalogues"
            />

            <span class="search-label">
              Search
            </span>

          </div>


          <!-- CATEGORY FILTER -->

          <div class="category-filter">

            {
              categories.map((category, index) => (
                <button
                  type="button"
                  class:list={{
                    "category-button": true,
                    active: index === 0,
                  }}
                  data-category={category}
                >
                  {category}
                </button>
              ))
            }

          </div>


          <!-- CATALOGUE GRID -->

          <div
            class="catalogue-grid"
            id="catalogue-grid"
          >

            {
              catalogues.map((catalogue, index) => (
                <article
                  class="catalogue-card"
                  data-category={catalogue.category}
                  data-search={`${catalogue.title} ${catalogue.category} ${catalogue.shortDescription}`.toLowerCase()}
                >

                  <a
                    href={catalogue.publishUrl}
                    class="catalogue-image"
                  >

                    {
                      catalogue.image ? (
                        <img
                          src={catalogue.image}
                          alt={catalogue.title}
                          loading={index > 2 ? "lazy" : "eager"}
                        />
                      ) : (
                        <div class="image-placeholder">
                          <span>
                            {catalogue.experience.icon}
                          </span>
                        </div>
                      )
                    }

                    <div class="card-number">
                      {String(index + 1).padStart(2, "0")}
                    </div>

                  </a>


                  <div class="catalogue-card-body">

                    <div class="card-meta">

                      <span
                        class="card-dot"
                        style={`--accent:${catalogue.experience.color};`}
                      ></span>

                      <span>
                        {catalogue.category}
                      </span>

                    </div>


                    <h3>
                      {catalogue.title}
                    </h3>

                    <p>
                      {catalogue.shortDescription}
                    </p>


                    <div class="card-footer">

                      <span>
                        {catalogue.experience.title}
                      </span>

                      <a
                        href={catalogue.publishUrl}
                      >
                        Explore →
                      </a>

                    </div>

                  </div>

                </article>
              ))
            }

          </div>


          <div
            class="empty-results"
            id="empty-results"
            hidden
          >
            <strong>
              Nothing matched your search.
            </strong>

            <span>
              Try another product or category.
            </span>
          </div>

        </div>

      </section>


      <!-- =====================================================
           HOW IT WORKS
      ====================================================== -->

      <section
        id="how-it-works"
        class="how-section"
      >

        <div class="section-container">

          <div class="how-heading">

            <div class="section-eyebrow">
              HOW IT WORKS
            </div>

            <h2>
              Buying custom products
              <br />
              shouldn't feel complicated.
            </h2>

            <p>
              QuoteLens helps customers move from
              uncertainty to a prepared enquiry.
            </p>

          </div>


          <div class="how-grid">

            {
              howItWorks.map((step) => (
                <div class="how-step">

                  <div class="step-top">
                    <span class="step-icon">
                      →
                    </span>

                    <small>
                      {step.number}
                    </small>
                  </div>

                  <div>

                    <h3>
                      {step.title}
                    </h3>

                    <p>
                      {step.text}
                    </p>

                  </div>

                </div>
              ))
            }

          </div>

        </div>

      </section>


      <!-- =====================================================
           MARKETPLACE
      ====================================================== -->

      <section
        id="marketplace"
        class="marketplace-section"
      >

        <div class="section-container">

          <div class="marketplace-heading">

            <div>

              <div class="section-eyebrow">
                MARKETPLACE
              </div>

              <h2>
                Find something
                <br />
                that fits.
              </h2>

            </div>

            <div class="marketplace-intro">

              <p>
                Browse products published by businesses
                and enter the buying experience directly.
              </p>

              <a href="/marketplace">
                Browse marketplace →
              </a>

            </div>

          </div>


          <div class="marketplace-grid">

            {
              marketplacePreview.map((product) => (
                <article class="marketplace-card">

                  <div class="marketplace-card-top">

                    <span class="marketplace-category">
                      {product.icon}
                      {product.category}
                    </span>

                    <span class="marketplace-arrow">
                      ↗
                    </span>

                  </div>


                  <div class="marketplace-product">

                    <div class="marketplace-image">
                      {product.icon}
                    </div>

                    <div>

                      <span class="business-name">
                        {product.business}
                      </span>

                      <h3>
                        {product.title}
                      </h3>

                      <p>
                        {product.description}
                      </p>

                    </div>

                  </div>


                  <a
                    href="/marketplace"
                    class="marketplace-action"
                  >
                    {product.action}
                    <span>→</span>
                  </a>

                </article>
              ))
            }

          </div>

        </div>

      </section>


      <!-- =====================================================
           BUSINESS SECTION
      ====================================================== -->

      <section class="business-section">

        <div class="section-container">

          <div class="business-grid">

            <div>

              <div class="section-eyebrow">
                FOR BUSINESSES
              </div>

              <h2>
                Turn your products
                <span>
                  into structured
                  buying experiences.
                </span>
              </h2>

            </div>


            <div class="business-content">

              <p class="business-lead">
                Configure your products once. Give customers
                a better way to tell you what they need.
              </p>


              <div class="business-benefits">

                <div>

                  <span>
                    01
                  </span>

                  <div>

                    <strong>
                      Structured enquiries
                    </strong>

                    <p>
                      Customers arrive with useful
                      specifications already attached.
                    </p>

                  </div>

                </div>


                <div>

                  <span>
                    02
                  </span>

                  <div>

                    <strong>
                      Searchable products
                    </strong>

                    <p>
                      Your catalogue becomes discoverable
                      through the QuoteLens marketplace.
                    </p>

                  </div>

                </div>


                <div>

                  <span>
                    03
                  </span>

                  <div>

                    <strong>
                      Better conversations
                    </strong>

                    <p>
                      Spend less time figuring out what
                      the customer is asking for.
                    </p>

                  </div>

                </div>

              </div>


              <a
                href="/join"
                class="button button-dark business-button"
              >
                Publish your catalogue
                <span>→</span>
              </a>

            </div>

          </div>

        </div>

      </section>


      <!-- =====================================================
           COMMUNITY
      ====================================================== -->

      <section class="community-section">

        <div class="section-container">

          <div class="community-inner">

            <div class="section-eyebrow">
              COMMUNITY VALIDATION
            </div>

            <h2>
              We're building this
              <br />
              with the people who
              <br />
              will use it.
            </h2>

            <p>
              QuoteLens is exploring what happens when
              specification-driven buying comes to the
              fragmented world of custom and made-to-order
              products.
            </p>


            <div class="community-action">

              <div>

                <strong>
                  Was QuoteLens useful?
                </strong>

                <span>
                  Tell us what you think.
                </span>

              </div>

              <a href="/community">
                Share your experience →
              </a>

            </div>

          </div>

        </div>

      </section>


      <!-- =====================================================
           FINAL CTA
      ====================================================== -->

      <section class="final-cta">

        <div class="section-container">

          <div class="final-cta-inner">

            <div class="section-eyebrow">
              QUOTELENS
            </div>

            <h2>
              Make the next enquiry
              <br />
              a better one.
            </h2>

            <p>
              Tell us what you need.
              Discover what fits.
              Start the right conversation.
            </p>


            <div class="final-actions">

              <a
                href="#catalogues"
                class="button button-white"
              >
                Explore products
                <span>→</span>
              </a>

              <a
                href="/join"
                class="button button-outline-white"
              >
                Publish your catalogue
              </a>

            </div>

          </div>

        </div>

      </section>

    </main>


    <!-- =====================================================
         FOOTER
    ====================================================== -->

    <footer class="site-footer">

      <div class="section-container">

        <div class="footer-main">

          <div class="footer-brand">

            <a
              href="/"
              class="brand footer-logo"
            >

              <span class="brand-mark">
                Q
              </span>

              <span>
                QuoteLens
              </span>

            </a>

            <p>
              Specification-driven buying for custom
              and made-to-order products.
            </p>

          </div>


          <div class="footer-links">

            <div>

              <span>
                EXPLORE
              </span>

              <a href="#catalogues">
                Catalogues
              </a>

              <a href="#how-it-works">
                How it works
              </a>

              <a href="#marketplace">
                Marketplace
              </a>

            </div>


            <div>

              <span>
                FOR BUSINESSES
              </span>

              <a href="/join">
                Publish
              </a>

              <a href="/signin">
                Sign in
              </a>

            </div>


            <div>

              <span>
                COMMUNITY
              </span>

              <a href="/community">
                Community
              </a>

              <a href="/help">
                Help
              </a>

            </div>

          </div>

        </div>


        <div class="footer-bottom">

          <span>
            © {new Date().getFullYear()} QuoteLens
          </span>

          <span>
            Built for better buying conversations.
          </span>

        </div>

      </div>

    </footer>


    <!-- =====================================================
         SEARCH / FILTER LOGIC
    ====================================================== -->

    <script>
      const searchInput =
        document.querySelector("#catalogue-search");

      const categoryButtons =
        document.querySelectorAll("[data-category]");

      const catalogueCards =
        document.querySelectorAll(".catalogue-card");

      const emptyResults =
        document.querySelector("#empty-results");

      let activeCategory = "All";


      function filterCatalogues() {

        const query =
          searchInput?.value
            ?.toLowerCase()
            ?.trim() || "";


        let visibleCount = 0;


        catalogueCards.forEach((card) => {

          const category =
            card.getAttribute("data-category") || "";

          const searchable =
            card.getAttribute("data-search") || "";


          const matchesCategory =
            activeCategory === "All" ||
            category === activeCategory;


          const matchesSearch =
            !query ||
            searchable.includes(query);


          const visible =
            matchesCategory &&
            matchesSearch;


          card.toggleAttribute(
            "hidden",
            !visible
          );


          if (visible) {
            visibleCount++;
          }

        });


        if (emptyResults) {
          emptyResults.hidden =
            visibleCount !== 0;
        }

      }


      categoryButtons.forEach((button) => {

        button.addEventListener(
          "click",
          () => {

            categoryButtons.forEach((item) => {
              item.classList.remove("active");
            });


            button.classList.add("active");


            activeCategory =
              button.getAttribute(
                "data-category"
              ) || "All";


            filterCatalogues();

          }
        );

      });


      searchInput?.addEventListener(
        "input",
        filterCatalogues
      );
    </script>


    <!-- =====================================================
         STYLES
    ====================================================== -->

    <style>

      :global(*) {
        box-sizing: border-box;
      }


      :global(html) {
        scroll-behavior: smooth;
      }


      :global(body) {
        margin: 0;
        background: #f7f4ed;
        color: #181714;
        font-family: "Manrope", sans-serif;
        -webkit-font-smoothing: antialiased;
      }


      :global(a) {
        color: inherit;
        text-decoration: none;
      }


      :global(button),
      :global(input) {
        font: inherit;
      }


      :global(button) {
        cursor: pointer;
      }


      .section-container {
        width: min(1180px, calc(100% - 80px));
        margin: 0 auto;
      }


      /* =====================================================
         NAV
      ====================================================== */

      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(247, 244, 237, 0.92);
        backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(24, 23, 20, 0.09);
      }


      .nav-inner {
        width: min(1180px, calc(100% - 80px));
        height: 70px;
        margin: 0 auto;

        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
      }


      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 17px;
        font-weight: 800;
        letter-spacing: -0.04em;
      }


      .brand-mark {
        width: 30px;
        height: 30px;

        display: grid;
        place-items: center;

        border-radius: 8px;

        background: #181714;
        color: #fff;

        font-size: 13px;
        font-weight: 800;
      }


      .desktop-nav {
        display: flex;
        align-items: center;
        gap: 34px;
        margin-left: auto;
        margin-right: auto;
      }


      .desktop-nav a,
      .signin-link {
        color: #68645d;
        font-size: 13px;
        font-weight: 600;
        transition: color 0.2s ease;
      }


      .desktop-nav a:hover,
      .signin-link:hover {
        color: #181714;
      }


      .nav-actions {
        display: flex;
        align-items: center;
        gap: 20px;
      }


      .nav-cta {
        padding: 12px 18px;
        border-radius: 999px;
        background: #181714;
        color: white;

        font-size: 12px;
        font-weight: 800;

        transition:
          transform 0.2s ease,
          background 0.2s ease;
      }


      .nav-cta:hover {
        transform: translateY(-1px);
        background: #2b2924;
      }


      /* =====================================================
         SHARED
      ====================================================== */

      .eyebrow,
      .section-eyebrow {
        color: #b27c19;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }


      .eyebrow {
        display: flex;
        align-items: center;
        gap: 9px;
      }


      .eyebrow-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #b27c19;
      }


      .button {
        min-height: 48px;
        padding: 0 21px;

        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 18px;

        border-radius: 999px;

        font-size: 13px;
        font-weight: 800;

        transition:
          transform 0.2s ease,
          background 0.2s ease;
      }


      .button:hover {
        transform: translateY(-2px);
      }


      .button-dark {
        background: #181714;
        color: white;
      }


      .button-dark:hover {
        background: #292823;
      }


      .button-light {
        border: 1px solid #d9d2c5;
        background: transparent;
      }


      .button-white {
        background: white;
        color: #181714;
      }


      .button-outline-white {
        border: 1px solid rgba(255,255,255,0.45);
        color: white;
      }


      /* =====================================================
         HERO
      ====================================================== */

      .hero {
        overflow: hidden;
        background:
          radial-gradient(
            circle at 76% 40%,
            rgba(201, 151, 61, 0.13),
            transparent 31%
          ),
          #f7f4ed;
      }


      .hero-inner {
        width: min(1180px, calc(100% - 80px));
        min-height: 720px;
        margin: 0 auto;

        display: grid;
        grid-template-columns: 1fr 0.92fr;
        align-items: center;
        gap: 70px;

        padding: 90px 0 110px;
      }


      .hero-copy {
        max-width: 620px;
      }


      .hero h1 {
        margin: 28px 0 26px;

        font-size: clamp(58px, 6.5vw, 94px);
        line-height: 0.91;
        letter-spacing: -0.075em;
        font-weight: 800;
      }


      .hero h1 span {
        display: block;
      }


      .hero h1 strong {
        display: block;
        color: #817b72;
        font-weight: 800;
      }


      .hero-description {
        max-width: 600px;
        margin: 0;

        color: #655f57;

        font-size: 17px;
        line-height: 1.75;
        letter-spacing: -0.02em;
      }


      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 30px;
      }


      .hero-note {
        margin-top: 28px;
        padding-left: 18px;

        border-left: 1px solid #c99a48;

        color: #837b70;
        font-size: 11px;
      }


      /* HERO EXPERIENCE */

      .hero-experience {
        position: relative;
      }


      .experience-window {
        overflow: hidden;

        border: 1px solid #ded8ce;
        border-radius: 26px;

        background: rgba(255,255,255,0.82);

        box-shadow:
          0 30px 80px rgba(42, 35, 23, 0.11),
          0 8px 20px rgba(42, 35, 23, 0.05);

        transform: rotate(1deg);
      }


      .window-bar {
        height: 48px;
        padding: 0 18px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        border-bottom: 1px solid #e8e2d9;

        color: #aaa39a;
        font-size: 10px;
        font-weight: 700;
      }


      .window-dots {
        display: flex;
        gap: 5px;
      }


      .window-dots span {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #d8d1c6;
      }


      .experience-content {
        padding: 42px 40px 38px;
      }


      .experience-label {
        color: #8c857a;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.16em;
      }


      .experience-content h2 {
        margin: 16px 0 34px;

        font-size: clamp(35px, 4vw, 53px);
        line-height: 0.94;
        letter-spacing: -0.065em;
      }


      .journey-progress {
        display: flex;
        align-items: center;
        margin-bottom: 30px;
      }


      .journey-step {
        display: flex;
        flex-direction: column;
        gap: 3px;
        white-space: nowrap;
      }


      .journey-step small {
        color: #b0a89e;
        font-size: 8px;
        font-weight: 800;
      }


      .journey-step span {
        color: #aaa39a;
        font-size: 9px;
        font-weight: 700;
      }


      .journey-step.active span {
        color: #181714;
      }


      .journey-line {
        height: 1px;
        min-width: 25px;
        flex: 1;
        margin: 0 10px;
        background: #ddd7ce;
      }


      .experience-product {
        display: flex;
        align-items: center;
        gap: 15px;

        padding: 15px;

        border: 1px solid #e1dbd1;
        border-radius: 17px;

        background: #fff;
      }


      .product-icon {
        width: 64px;
        height: 64px;

        display: grid;
        place-items: center;

        flex: 0 0 auto;

        border-radius: 13px;

        background: #ebe6dc;

        font-size: 25px;
      }


      .product-details {
        min-width: 0;
        flex: 1;
      }


      .product-details span {
        color: #b27c19;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: 0.12em;
      }


      .product-details strong {
        display: block;
        margin-top: 4px;

        font-size: 14px;
        letter-spacing: -0.03em;
      }


      .product-details p {
        margin: 4px 0 0;

        color: #999187;
        font-size: 9px;
      }


      .product-arrow {
        color: #817b72;
      }


      .experience-specs {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;

        margin-top: 10px;
      }


      .experience-specs > div {
        padding: 12px;

        border-radius: 12px;

        background: #f5f1ea;
      }


      .experience-specs small {
        display: block;

        color: #a49d93;
        font-size: 7px;
        font-weight: 800;
        letter-spacing: 0.1em;
      }


      .experience-specs strong {
        display: block;
        margin-top: 5px;

        font-size: 10px;
      }


      /* =====================================================
         THESIS
      ====================================================== */

      .thesis {
        padding: 130px 0;
        background: #181714;
        color: white;
      }


      .thesis .section-eyebrow {
        color: #c69335;
      }


      .thesis-grid {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: 100px;
        margin-top: 38px;
      }


      .thesis h2 {
        margin: 0;

        font-size: clamp(43px, 5.2vw, 70px);
        line-height: 0.98;
        letter-spacing: -0.065em;
      }


      .thesis h2 span {
        display: block;
        color: #77736c;
      }


      .thesis-copy {
        align-self: end;
      }


      .thesis-copy > p {
        margin: 0 0 35px;

        color: #aaa69f;

        font-size: 16px;
        line-height: 1.75;
      }


      .comparison {
        border-top: 1px solid #37352f;
      }


      .comparison-row {
        display: grid;
        grid-template-columns: 150px 1fr;
        gap: 25px;

        padding: 20px 0;

        border-bottom: 1px solid #37352f;
      }


      .comparison-row span {
        color: #77736c;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }


      .comparison-row strong {
        color: #aaa69f;
        font-size: 12px;
        font-weight: 600;
      }


      .comparison-row.highlight strong {
        color: #d0a04a;
      }


      /* =====================================================
         CATALOGUES
      ====================================================== */

      .catalogues-section {
        padding: 130px 0;
        background: #f7f4ed;
      }


      .catalogue-heading {
        display: grid;
        grid-template-columns: 1fr 0.6fr;
        gap: 70px;
        align-items: end;
      }


      .catalogue-heading h2,
      .marketplace-heading h2 {
        margin: 22px 0 0;

        font-size: clamp(48px, 5.5vw, 76px);
        line-height: 0.95;
        letter-spacing: -0.07em;
      }


      .catalogue-heading > p {
        margin: 0;

        color: #736c63;

        font-size: 14px;
        line-height: 1.75;
      }


      .catalogue-search {
        height: 62px;
        margin-top: 55px;

        display: flex;
        align-items: center;
        gap: 14px;

        padding: 0 20px;

        border: 1px solid #ddd6cb;
        border-radius: 14px;

        background: #fff;
      }


      .search-icon {
        color: #938b81;
        font-size: 20px;
      }


      .catalogue-search input {
        min-width: 0;
        flex: 1;

        border: 0;
        outline: 0;

        background: transparent;

        color: #181714;
        font-size: 13px;
      }


      .catalogue-search input::placeholder {
        color: #9c958b;
      }


      .search-label {
        color: #8e877e;
        font-size: 10px;
        font-weight: 700;
      }


      .category-filter {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;

        margin-top: 15px;
      }


      .category-button {
        padding: 9px 16px;

        border: 1px solid #ded7cd;
        border-radius: 999px;

        background: transparent;

        color: #716a61;

        font-size: 11px;
        font-weight: 700;
      }


      .category-button.active,
      .category-button:hover {
        border-color: #181714;
        background: #181714;
        color: white;
      }


      .catalogue-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;

        margin-top: 35px;
      }


      .catalogue-card {
        overflow: hidden;

        border: 1px solid #e0d9cf;
        border-radius: 18px;

        background: #fff;

        transition:
          transform 0.25s ease,
          box-shadow 0.25s ease;
      }


      .catalogue-card:hover {
        transform: translateY(-5px);

        box-shadow:
          0 18px 40px rgba(39, 32, 22, 0.08);
      }


      .catalogue-card[hidden] {
        display: none;
      }


      .catalogue-image {
        position: relative;
        display: block;

        height: 280px;

        overflow: hidden;

        background: #e9e3d9;
      }


      .catalogue-image img {
        width: 100%;
        height: 100%;

        display: block;

        object-fit: cover;

        transition: transform 0.5s ease;
      }


      .catalogue-card:hover .catalogue-image img {
        transform: scale(1.035);
      }


      .image-placeholder {
        width: 100%;
        height: 100%;

        display: grid;
        place-items: center;

        background:
          radial-gradient(
            circle at center,
            #f6f2ea,
            #dcd5c9
          );
      }


      .image-placeholder span {
        font-size: 45px;
        filter: grayscale(0.2);
      }


      .card-number {
        position: absolute;
        top: 15px;
        right: 15px;

        padding: 7px 9px;

        border-radius: 999px;

        background: rgba(255,255,255,0.88);

        color: #6e675e;

        font-size: 9px;
        font-weight: 800;
      }


      .catalogue-card-body {
        padding: 23px;
      }


      .card-meta {
        display: flex;
        align-items: center;
        gap: 7px;

        color: #8b847a;

        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }


      .card-dot {
        width: 6px;
        height: 6px;

        border-radius: 50%;

        background: var(--accent);
      }


      .catalogue-card h3 {
        margin: 12px 0 8px;

        font-size: 22px;
        letter-spacing: -0.05em;
      }


      .catalogue-card-body > p {
        min-height: 48px;
        margin: 0;

        color: #777067;

        font-size: 12px;
        line-height: 1.65;
      }


      .card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;

        margin-top: 24px;
        padding-top: 17px;

        border-top: 1px solid #eee9e1;
      }


      .card-footer > span {
        color: #9b9389;
        font-size: 10px;
        font-weight: 700;
      }


      .card-footer a {
        color: #181714;
        font-size: 10px;
        font-weight: 800;
      }


      .empty-results {
        padding: 70px 0;
        text-align: center;
      }


      .empty-results strong,
      .empty-results span {
        display: block;
      }


      .empty-results span {
        margin-top: 8px;
        color: #8b847a;
        font-size: 13px;
      }


      /* =====================================================
         HOW IT WORKS
      ====================================================== */

      .how-section {
        padding: 130px 0;
        background: #ebe7df;
      }


      .how-heading {
        max-width: 900px;
        margin: 0 auto;
        text-align: center;
      }


      .how-heading h2 {
        margin: 25px 0;

        font-size: clamp(46px, 5.5vw, 76px);
        line-height: 0.96;
        letter-spacing: -0.07em;
      }


      .how-heading p {
        margin: 0;

        color: #756e65;
        font-size: 14px;
      }


      .how-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);

        margin-top: 70px;

        border: 1px solid #d7d1c7;
      }


      .how-step {
        min-height: 280px;
        padding: 28px;

        display: flex;
        flex-direction: column;
        justify-content: space-between;

        border-right: 1px solid #d7d1c7;
      }


      .how-step:last-child {
        border-right: 0;
      }


      .step-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
      }


      .step-icon {
        width: 48px;
        height: 48px;

        display: grid;
        place-items: center;

        border: 1px solid #d7d1c7;
        border-radius: 13px;

        background: #f7f4ed;
      }


      .step-top small {
        color: #a39b91;
        font-size: 9px;
        font-weight: 800;
      }


      .how-step h3 {
        margin: 0 0 10px;

        font-size: 24px;
        letter-spacing: -0.05em;
      }


      .how-step p {
        max-width: 210px;
        margin: 0;

        color: #756e65;

        font-size: 12px;
        line-height: 1.7;
      }


      /* =====================================================
         MARKETPLACE
      ====================================================== */

      .marketplace-section {
        padding: 130px 0;
        background: #fffdfa;
      }


      .marketplace-heading {
        display: grid;
        grid-template-columns: 1fr 0.55fr;
        gap: 80px;
        align-items: end;
      }


      .marketplace-intro {
        align-self: end;
      }


      .marketplace-intro p {
        margin: 0 0 20px;

        color: #756e65;
        font-size: 14px;
        line-height: 1.7;
      }


      .marketplace-intro a {
        color: #181714;
        font-size: 12px;
        font-weight: 800;
      }


      .marketplace-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;

        margin-top: 65px;
      }


      .marketplace-card {
        padding: 25px;

        border-top: 1px solid #dcd5ca;
        border-bottom: 1px solid #dcd5ca;
      }


      .marketplace-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }


      .marketplace-category {
        display: flex;
        align-items: center;
        gap: 7px;

        color: #777067;

        font-size: 10px;
        font-weight: 700;
      }


      .marketplace-arrow {
        color: #a39a8f;
      }


      .marketplace-product {
        display: flex;
        gap: 16px;

        margin-top: 38px;
      }


      .marketplace-image {
        width: 70px;
        height: 70px;

        flex: 0 0 auto;

        display: grid;
        place-items: center;

        border-radius: 15px;

        background: #e9e3d9;

        font-size: 28px;
      }


      .business-name {
        color: #b27c19;

        font-size: 8px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }


      .marketplace-product h3 {
        margin: 6px 0;

        font-size: 20px;
        letter-spacing: -0.04em;
      }


      .marketplace-product p {
        margin: 0;

        color: #777067;

        font-size: 11px;
        line-height: 1.55;
      }


      .marketplace-action {
        display: flex;
        align-items: center;
        justify-content: space-between;

        margin-top: 30px;

        color: #181714;

        font-size: 11px;
        font-weight: 800;
      }


      /* =====================================================
         BUSINESS
      ====================================================== */

      .business-section {
        padding: 140px 0;

        background: #181714;
        color: white;
      }


      .business-grid {
        display: grid;
        grid-template-columns: 1fr 0.85fr;
        gap: 100px;
      }


      .business-section .section-eyebrow {
        color: #c69335;
      }


      .business-section h2 {
        margin: 25px 0 0;

        font-size: clamp(46px, 5.4vw, 74px);
        line-height: 0.96;
        letter-spacing: -0.07em;
      }


      .business-section h2 span {
        display: block;
        color: #77736c;
      }


      .business-content {
        align-self: end;
      }


      .business-lead {
        margin: 0 0 40px;

        color: #aaa69f;

        font-size: 16px;
        line-height: 1.7;
      }


      .business-benefits {
        border-top: 1px solid #37352f;
      }


      .business-benefits > div {
        display: grid;
        grid-template-columns: 35px 1fr;
        gap: 20px;

        padding: 22px 0;

        border-bottom: 1px solid #37352f;
      }


      .business-benefits span {
        color: #c69335;
        font-size: 9px;
        font-weight: 800;
      }


      .business-benefits strong {
        font-size: 13px;
      }


      .business-benefits p {
        margin: 6px 0 0;

        color: #77736c;

        font-size: 11px;
        line-height: 1.6;
      }


      .business-button {
        margin-top: 30px;
      }


      /* =====================================================
         COMMUNITY
      ====================================================== */

      .community-section {
        padding: 130px 0;

        background: #f0ebe2;
      }


      .community-inner {
        max-width: 850px;
        margin: 0 auto;
        text-align: center;
      }


      .community-inner h2 {
        margin: 25px 0;

        font-size: clamp(45px, 5.3vw, 70px);
        line-height: 0.97;
        letter-spacing: -0.07em;
      }


      .community-inner > p {
        max-width: 650px;
        margin: 0 auto;

        color: #716960;

        font-size: 14px;
        line-height: 1.75;
      }


      .community-action {
        max-width: 680px;

        margin: 55px auto 0;
        padding: 24px;

        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;

        border: 1px solid #d8d0c4;
        border-radius: 16px;

        background: #fffdfa;

        text-align: left;
      }


      .community-action strong,
      .community-action span {
        display: block;
      }


      .community-action strong {
        font-size: 13px;
      }


      .community-action span {
        margin-top: 5px;

        color: #8b8379;

        font-size: 10px;
      }


      .community-action a {
        color: #181714;

        font-size: 11px;
        font-weight: 800;

        white-space: nowrap;
      }


      /* =====================================================
         FINAL CTA
      ====================================================== */

      .final-cta {
        padding: 120px 0;

        background: #b78629;
        color: #181714;
      }


      .final-cta-inner {
        text-align: center;
      }


      .final-cta .section-eyebrow {
        color: #5e4517;
      }


      .final-cta h2 {
        margin: 24px 0 20px;

        font-size: clamp(50px, 6vw, 84px);
        line-height: 0.94;
        letter-spacing: -0.075em;
      }


      .final-cta p {
        margin: 0;

        color: #4d3a19;

        font-size: 15px;
      }


      .final-actions {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;

        margin-top: 35px;
      }


      /* =====================================================
         FOOTER
      ====================================================== */

      .site-footer {
        padding: 70px 0 25px;

        background: #181714;
        color: white;
      }


      .footer-main {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 100px;
      }


      .footer-logo {
        color: white;
      }


      .footer-brand p {
        max-width: 310px;
        margin-top: 20px;

        color: #77736c;

        font-size: 12px;
        line-height: 1.7;
      }


      .footer-links {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
      }


      .footer-links > div {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }


      .footer-links span {
        margin-bottom: 6px;

        color: #77736c;

        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.1em;
      }


      .footer-links a {
        color: #c2beb8;

        font-size: 11px;
      }


      .footer-links a:hover {
        color: white;
      }


      .footer-bottom {
        display: flex;
        justify-content: space-between;

        margin-top: 70px;
        padding-top: 20px;

        border-top: 1px solid #37352f;

        color: #68645d;

        font-size: 9px;
      }


      /* =====================================================
         RESPONSIVE
      ====================================================== */

      @media (max-width: 900px) {

        .section-container,
        .nav-inner,
        .hero-inner {
          width: min(100% - 40px, 700px);
        }


        .desktop-nav {
          display: none;
        }


        .hero-inner,
        .thesis-grid,
        .catalogue-heading,
        .marketplace-heading,
        .business-grid,
        .footer-main {
          grid-template-columns: 1fr;
        }


        .hero-inner {
          padding: 70px 0 80px;
          gap: 60px;
        }


        .hero h1 {
          font-size: clamp(56px, 14vw, 82px);
        }


        .hero-experience {
          max-width: 650px;
          width: 100%;
          margin: 0 auto;
        }


        .thesis-grid {
          gap: 50px;
        }


        .catalogue-heading {
          gap: 25px;
        }


        .catalogue-grid,
        .marketplace-grid {
          grid-template-columns: repeat(2, 1fr);
        }


        .how-grid {
          grid-template-columns: repeat(2, 1fr);
        }


        .how-step:nth-child(2) {
          border-right: 0;
        }


        .how-step:nth-child(-n+2) {
          border-bottom: 1px solid #d7d1c7;
        }


        .business-grid {
          gap: 60px;
        }


        .footer-main {
          gap: 60px;
        }

      }


      @media (max-width: 600px) {

        .section-container,
        .nav-inner,
        .hero-inner {
          width: calc(100% - 30px);
        }


        .nav-inner {
          height: 62px;
        }


        .nav-actions {
          gap: 10px;
        }


        .signin-link {
          display: none;
        }


        .nav-cta {
          padding: 10px 13px;
          font-size: 10px;
        }


        .hero-inner {
          min-height: auto;
          padding: 60px 0 70px;
        }


        .hero-description {
          font-size: 15px;
        }


        .hero-actions {
          flex-direction: column;
        }


        .hero-actions .button {
          width: 100%;
        }


        .experience-content {
          padding: 28px 22px;
        }


        .experience-content h2 {
          font-size: 38px;
        }


        .journey-progress {
          display: none;
        }


        .experience-specs {
          grid-template-columns: 1fr;
        }


        .thesis,
        .catalogues-section,
        .how-section,
        .marketplace-section,
        .business-section,
        .community-section {
          padding: 85px 0;
