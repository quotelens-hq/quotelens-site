---
import { catalogues } from "../data/catalogues";
 
const categories = [
  "All",
  "Food",
  "Fashion",
  "Home Improvement",
  "Furniture",
  "Automotive",
];
 
// Plantation Shutters is the priority catalogue right now — it
// should always be the first tile shown, ahead of the site's
// default/insertion order. A stable sort (rather than a filter +
// unshift) keeps every other catalogue in its existing relative
// order behind it, so this is purely a "float to the top" nudge,
// not a reshuffle of everything else.
const PRIORITY_TEMPLATE_ID = "plantation_shutters";
 
function isPriorityCatalogue(catalogue) {
  return Boolean(catalogue?.publishUrl?.includes(`template=${PRIORITY_TEMPLATE_ID}`));
}
 
const orderedCatalogues = [...catalogues].sort((a, b) => {
  const aRank = isPriorityCatalogue(a) ? 0 : 1;
  const bRank = isPriorityCatalogue(b) ? 0 : 1;
  return aRank - bRank;
});
