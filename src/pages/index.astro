---
import Layout from '../layouts/Layout.astro'
import Footer from '../components/Footer.astro'

const SUPPORT_WHATSAPP = '254712837514'
const SUPPORT_EMAIL = 'quotelensapp@gmail.com'

const USD_RATE = 130
function approxUsd(kshAmount) {
  return Math.round(kshAmount / USD_RATE)
}

// Used to build the sidebar's category filter buttons. Not rendered
// as cards themselves anymore — the real product grid below is the
// actual browsing surface now that /market no longer exists as a
// separate page.
const CATEGORY_META = {
  cakes:                { group: 'Food' },
  flowers:               { group: 'Flowers' },
  womens_dresses:         { group: 'Fashion' },
  plantation_shutters:    { group: 'Home Improvement' },
  curtains:               { group: 'Home Improvement' },
  wooden_doors:           { group: 'Home Improvement' },
  steel_doors:            { group: 'Home Improvement' },
  gates:                  { group: 'Home Improvement' },
  garage_doors:           { group: 'Home Improvement' },
  kitchen_island:         { group: 'Furniture' },
  blinds:                 { group: 'Home Improvement' }
}

const CATEGORY_GROUPS = [...new Set(Object.values(CATEGORY_META).map(c => c.group))]
---
<Layout>

  <!-- ── NAV ────────────────────────────────────────────── -->
  <nav class="nav">
    <div class="nav-inner">
      <a class="nav-brand" href="/">QuoteLens</a>
      <div class="nav-links">
        <a href="#marketplace-home">Marketplace</a>
        <a class="nav-hide-sm" href="#how">How It Works</a>
        <a class="nav-hide-sm" href="#pricing">Pricing</a>
        <a class="nav-hide-sm" href="#community">Community</a>
        <a class="nav-hide-sm" href="#help">Help</a>
        <a href="/admin">Sign In</a>
        <a class="nav-cta" href="/join">Publish Catalogue</a>
      </div>
    </div>
  </nav>

  <!-- ── 1. HERO (minimal) ── (paper) ───────────────────── -->
  <div class="band band-paper">
    <section id="promise" style="text-align:center; padding-top: 70px;">
      <p class="eyebrow-badge">Interactive Product Catalogue Infrastructure</p>
      <h1>Let Your Customers<br />Buy with Confidence.</h1>
      <p style="margin-top:16px; font-size:1.15rem; max-width:560px; margin-left:auto; margin-right:auto;">
        Turn your products into interactive shopping experiences.
      </p>
      <p style="margin-top:10px; max-width:520px; margin-left:auto; margin-right:auto; color:var(--ink-faint);">
        Configure your products once. Customers browse specifications, compare
        options, and enquire with confidence.
      </p>

      <div style="margin-top:30px; display:flex; gap:14px; justify-content:center; flex-wrap:wrap;">
        <a class="btn btn-primary" href="/join">Publish Catalogue</a>
        <a class="btn btn-ghost" href="#marketplace-home">Experience Live Demo</a>
      </div>

      <p style="margin-top:18px; font-size:0.85rem; color:var(--ink-faint);">
        Built for businesses selling products that require customer specifications before purchase.
      </p>
    </section>
  </div>

  <!-- ── 2. MARKETPLACE — this IS the homepage. Real listings,
       no separate page. Sidebar filters the actual live grid
       below, not a navigation target. ────────────────────── -->
  <div class="band band-white">
    <section id="marketplace-home">
      <div class="catalogue-layout">
        <aside class="catalogue-sidebar">
          <input
            id="catalogue-search"
            class="catalogue-search"
            type="text"
            placeholder="Search custom products"
          />

          <p class="catalogue-sidebar-title">Browse Categories</p>
          <div class="catalogue-category-list">
            <button class="catalogue-cat-filter active" data-group="all">All</button>
            {CATEGORY_GROUPS.map((group) => (
              <button class="catalogue-cat-filter" data-group={group}>{group}</button>
            ))}
          </div>

          <div class="catalogue-tour-box">
            <p class="catalogue-tour-title">✨ New to QuoteLens?</p>
            <p class="catalogue-tour-text">
              Browse a real listing below and walk a quote yourself — that's the
              60-second tour.
            </p>
          </div>

          <div class="catalogue-community-box">
            <p class="catalogue-tour-title">Help Shape QuoteLens</p>
            <p class="catalogue-tour-text">
              Tell us if this should exist. One participant wins KSh 30,000.
            </p>
            <a class="btn btn-ghost" href="#community" style="width:100%; text-align:center; margin-top:10px;">
              Leave Your Opinion
            </a>
          </div>
        </aside>

        <div>
          <div id="market-status" style="text-align:center; color:var(--ink-faint); padding: 20px 0;">
            Loading products...
          </div>
          <div id="showroom-notice" style="display:none; max-width:640px; margin:0 auto 16px; text-align:center; font-size:0.85rem; color:var(--ink-faint); background:var(--card); border:1px solid var(--border); border-radius:8px; padding:10px 16px;">
            Listings marked <strong>DEMO</strong> are from QuoteLens' own Showroom tenant — shown to
            illustrate how a real business's listing looks. Their products, images, and prices are for
            demonstration only, not real offers.
          </div>
          <div id="market-grid" class="market-grid"></div>
        </div>
      </div>
    </section>
  </div>

  <!-- ── 3. COMMUNITY VALIDATION ── (tint) ──────────────── -->
  <div class="band band-tint">
    <section id="community" style="text-align:center;">
      <p class="eyebrow">Community Validation Program</p>
      <h2>Help Decide Whether QuoteLens Should Exist</h2>
      <p style="margin-top:14px; max-width:560px; margin-left:auto; margin-right:auto;">
        We're building a new way to buy and sell custom products. Experience it,
        challenge it, and tell us what you think.
      </p>

      <div class="community-stats" id="community-stats">
        <span class="community-stat-pill" id="stat-opinions">— opinions submitted</span>
        <span class="community-stat-pill" id="stat-quotes">— quotes completed across QuoteLens</span>
      </div>

      <div class="community-columns">
        <div class="community-form-card">
          <p class="community-form-title">Leave your opinion</p>
          <p style="font-size:0.9rem; margin-bottom:10px;">Was QuoteLens useful?</p>
          <div class="star-input" id="star-input">
            <span data-star="1">★</span>
            <span data-star="2">★</span>
            <span data-star="3">★</span>
            <span data-star="4">★</span>
            <span data-star="5">★</span>
          </div>
          <input
            id="opinion-name"
            type="text"
            placeholder="Your name (optional)"
            style="margin-top:14px;"
          />
          <textarea
            id="opinion-text"
            placeholder="What would make QuoteLens more useful for buyers or businesses?"
            rows="4"
            style="width:100%; margin-top:10px; padding:12px; border:1px solid var(--border); border-radius:8px; font-family:inherit; font-size:0.95rem; resize:vertical; box-sizing:border-box;"
          ></textarea>
          <button id="submit-opinion" class="btn btn-primary" style="width:100%; margin-top:12px;">
            Submit Opinion
          </button>
          <p id="opinion-status" style="font-size:0.82rem; color:var(--ink-faint); margin-top:8px; min-height:1.2em;"></p>
          <p style="font-size:0.8rem; color:var(--ink-faint); margin-top:6px;">
            One participant will receive KSh 30,000 at the end of the testing period.
          </p>
        </div>

        <div class="community-opinions-card">
          <p class="community-form-title">✨ Recent community opinions</p>
          <div id="opinions-list" class="opinions-list">
            <p style="font-size:0.85rem; color:var(--ink-faint);">Loading...</p>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- ── 4. BUSINESS VALUE ── (white) ───────────────────── -->
  <div class="band band-white">
    <section style="text-align:center;">
      <h2>What businesses receive</h2>

      <div class="value-cards">
        <div class="value-card">
          <p class="value-card-icon">📤</p>
          <p class="value-card-title">Publish Once</p>
          <p class="value-card-text">Configure products, specifications and pricing one time.</p>
        </div>
        <div class="value-card">
          <p class="value-card-icon">✨</p>
          <p class="value-card-title">Customers Self-Serve</p>
          <p class="value-card-text">Buyers explore products and answer the buying questions themselves.</p>
        </div>
        <div class="value-card">
          <p class="value-card-icon">✓</p>
          <p class="value-card-title">Receive Prepared Enquiries</p>
          <p class="value-card-text">Spend less time explaining and more time delivering orders.</p>
        </div>
      </div>
    </section>
  </div>

  <!-- ── 5. PRICING ── (tint) ───────────────────────────── -->
  <div class="band band-tint">
    <section id="pricing" style="text-align:center;">
      <p class="eyebrow">Pricing</p>
      <h2>Simple pricing. Pay with M-Pesa.</h2>

      <div class="plans">
        <div class="price-card">
          <p class="plan-name">QuoteLens Starter</p>
          <p class="price">KSh 2,500<span>/month</span></p>
          <p class="price-usd">≈ ${approxUsd(2500)} USD/month</p>
          <p class="plan-tag">Perfect if you're running this yourself.</p>
          <ul>
            <li>Your own quote page</li>
            <li>Limited AI-assisted measurements</li>
            <li>Unlimited customer quotes</li>
            <li>Marketplace listing</li>
            <li>WhatsApp &amp; email delivery</li>
            <li>Business dashboard</li>
            <li>Self-guided setup</li>
            <li>Standard support</li>
          </ul>
          <a class="btn btn-primary" href="/join" style="width:100%; text-align:center;">Get Started</a>
        </div>

        <div class="price-card">
          <p class="plan-name">QuoteLens Growth</p>
          <p class="price">KSh 5,500<span>/month</span></p>
          <p class="price-usd">≈ ${approxUsd(5500)} USD/month</p>
          <p class="plan-tag">For businesses handling higher volume.</p>
          <ul>
            <li>Your own quote page</li>
            <li>Higher AI-assisted measurements</li>
            <li>Unlimited customer quotes</li>
            <li><strong>Priority</strong> Marketplace listing</li>
            <li>WhatsApp &amp; email delivery</li>
            <li>Business dashboard</li>
            <li>We personally set up your product catalogue with you</li>
            <li><strong>Priority</strong> support</li>
          </ul>
          <a class="btn btn-primary" href="/join" style="width:100%; text-align:center;">Get Started</a>
        </div>
      </div>

      <p style="margin-top:18px; font-weight:600; color:var(--gold-dark);">
        Less than the cost of one unnecessary site visit.
      </p>
      <p class="trust-strip">
        Pay with M-Pesa · Prices billed in KSh · Cancel anytime
      </p>
    </section>
  </div>

  <!-- ── 6. FAQ ── (white) ──────────────────────────────── -->
  <div class="band band-white">
    <section id="faq">
      <h2 style="text-align:center;">Frequently asked questions</h2>

      <div class="faq-list">
        <details>
          <summary>Does QuoteLens replace WhatsApp?</summary>
          <p>No. Your customers still reach you on WhatsApp — they just
          arrive prepared: measurements confirmed, product chosen, price
          already seen. The conversation starts where it used to end.</p>
        </details>
        <details>
          <summary>Do customers install an app?</summary>
          <p>No. They tap your link — from an advert, your bio, or the
          QuoteLens Marketplace — and it opens in their browser.</p>
        </details>
        <details>
          <summary>What do I get for KSh 2,500 a month?</summary>
          <p>Your own quote page, unlimited customer quotes, your products
          listed on the QuoteLens Marketplace, and every enquiry delivered
          to WhatsApp and email with the details already gathered.</p>
        </details>
        <details>
          <summary>What's different on Growth?</summary>
          <p>A higher AI-assisted measurement allowance for busier operations, priority placement on
          the Marketplace, hands-on setup — we personally configure your product catalogue with you —
          and priority support. Both plans include AI-assisted measurement; Growth is built for
          higher volume.</p>
        </details>
        <details>
          <summary>How do I pay?</summary>
          <p>M-Pesa. Choose your plan, pay, and your account is live.
          Cancel anytime — your page simply stops at the end of the paid
          period.</p>
        </details>
        <details>
          <summary>Can I change my prices?</summary>
          <p>Yes, any time, from your dashboard. New quotes use your new
          rates immediately.</p>
        </details>
        <details>
          <summary>Can I try it before paying?</summary>
          <p>Yes — as a customer. Browse a real listing on this page and
          walk a quote journey yourself. What you experience there is exactly
          what your customers will experience on your page.</p>
        </details>
        <details>
          <summary>What businesses is QuoteLens for?</summary>
          <p>Any business selling made-to-measure or made-to-order products —
          curtains, doors, gates, kitchens, cakes, flowers, dresses, and more.</p>
        </details>
      </div>
    </section>
  </div>

  <!-- ── 7. HELP ── (tint) ─────────────────────────────── -->
  <div class="band band-tint">
    <section id="help" style="text-align:center;">
      <p class="eyebrow">Need a hand?</p>
      <h2>We're here if something isn't working.</h2>
      <p style="margin-top:14px; max-width:480px; margin-left:auto; margin-right:auto; color:var(--ink-faint);">
        Questions about signing up, your quote page, or a payment —
        reach out directly.
      </p>

      <div class="help-row">
        <a
          class="help-card"
          href={`https://wa.me/${SUPPORT_WHATSAPP}`}
          target="_blank"
          rel="noreferrer"
        >
          <span class="help-label">WhatsApp</span>
          <span class="help-value">+{SUPPORT_WHATSAPP}</span>
        </a>
        <a class="help-card" href={`mailto:${SUPPORT_EMAIL}`}>
          <span class="help-label">Email</span>
          <span class="help-value">{SUPPORT_EMAIL}</span>
        </a>
      </div>
    </section>
  </div>

  <!-- ── 8. FINAL CTA ── (dark) ─────────────────────────── -->
  <div class="final-band">
    <p>Ready to publish products<br />customers can actually shop?</p>
    <p style="margin-top:14px; font-size:1.05rem; font-weight:400; color:#cfc9bf;">
      Join the businesses building the future of custom shopping.
    </p>
    <div style="margin-top:26px; display:flex; gap:14px; justify-content:center; flex-wrap:wrap;">
      <a class="btn btn-primary" href="/join">Publish Your Catalogue</a>
      <a class="btn btn-ghost-dark" href="#marketplace-home">Experience the Live Marketplace</a>
    </div>
  </div>

  <Footer />

</Layout>

<script>
  import { supabase } from '../utils/supabase.js'

  const APP_DOMAIN = 'quote-lens.app'
  const SHOWROOM_TENANT_ID = 'showroom'

  const CATEGORY_META = {
    cakes:               { group: 'Food' },
    flowers:              { group: 'Flowers' },
    womens_dresses:        { group: 'Fashion' },
    plantation_shutters:   { group: 'Home Improvement' },
    curtains:              { group: 'Home Improvement' },
    wooden_doors:          { group: 'Home Improvement' },
    steel_doors:           { group: 'Home Improvement' },
    gates:                 { group: 'Home Improvement' },
    garage_doors:          { group: 'Home Improvement' },
    kitchen_island:        { group: 'Furniture' },
    blinds:                { group: 'Home Improvement' }
  }

  function formatDimension(dimension) {
    if (!dimension || dimension.arg1 == null || dimension.arg2 == null) return null
    const widthM = (Number(dimension.arg1) / 1000).toFixed(2)
    const heightM = (Number(dimension.arg2) / 1000).toFixed(2)
    return `${widthM}m × ${heightM}m`
  }

  let allCards = []

  async function loadMarketplace() {
    const statusEl = document.getElementById('market-status')
    const showroomNoticeEl = document.getElementById('showroom-notice')

    const { data: tenants, error } = await supabase
      .from('tenant_config')
      .select('tenant_id, business_name, currency_symbol, marketplace_listing, plan_tier')
      .eq('subscription_status', 'active')
      .eq('marketplace_listed', true)
      .not('marketplace_listing', 'is', null)

    if (error) {
      statusEl.textContent = 'Could not load the marketplace right now.'
      console.error(error)
      return
    }

    let hasShowroomCards = false

    ;(tenants || []).forEach((tenant) => {
      const listingsByTemplate = tenant.marketplace_listing
      if (!listingsByTemplate || typeof listingsByTemplate !== 'object') return

      const isShowroom = tenant.tenant_id === SHOWROOM_TENANT_ID
      const isGrowth = tenant.plan_tier === 'growth'

      // Iterate with the template id (the object key) preserved,
      // so each card can be filtered by category on this page —
      // market.astro never needed this since it had no on-page
      // category filter, only a query-param link from elsewhere.
      Object.entries(listingsByTemplate).forEach(([templateId, listing]) => {
        if (!listing?.cards?.length) return

        const dimensionLabel = formatDimension(listing.dimension)
        const group = CATEGORY_META[templateId]?.group || 'Other'

        listing.cards.forEach((card) => {
          if (!card.imageUrl) return

          if (isShowroom) hasShowroomCards = true

          allCards.push({
            tenantId: tenant.tenant_id,
            businessName: tenant.business_name,
            currencySymbol: tenant.currency_symbol || '',
            material: card.material?.label || '',
            spec: card.spec?.label || '',
            price: card.price,
            imageUrl: card.imageUrl,
            dimensionLabel,
            isShowroom,
            isGrowth,
            templateId,
            group
          })
        })
      })
    })

    allCards.sort((a, b) => (b.isGrowth ? 1 : 0) - (a.isGrowth ? 1 : 0))

    if (allCards.length === 0) {
      statusEl.textContent = 'No products listed yet — check back soon.'
      return
    }

    statusEl.remove()

    if (hasShowroomCards) {
      showroomNoticeEl.style.display = 'block'
    }

    renderCards(allCards)
  }

  function renderCards(cards) {
    const gridEl = document.getElementById('market-grid')

    if (cards.length === 0) {
      gridEl.innerHTML = `<p style="text-align:center; color:var(--ink-faint); padding:20px 0;">
        No listings in this category yet — check back soon.
      </p>`
      return
    }

    gridEl.innerHTML = cards.map((card) => `
      <a class="market-card" href="https://${APP_DOMAIN}/t/${card.tenantId}">
        <img src="${card.imageUrl}" alt="${card.material} ${card.spec}" loading="lazy" />
        <div class="market-card-body">
          <p class="market-card-business">
            ${card.businessName}${card.isShowroom ? '<span class="market-card-demo-tag">DEMO</span>' : ''}
          </p>
          ${card.dimensionLabel ? `<p class="market-card-dimension">${card.dimensionLabel}</p>` : ''}
          <p class="market-card-title">${card.material}</p>
          <p class="market-card-spec">${card.spec}</p>
          <p class="market-card-price">${card.currencySymbol} ${Number(card.price).toLocaleString()}</p>
        </div>
      </a>
    `).join('')
  }

  // ── Sidebar filtering — filters the REAL grid loaded above,
  // never navigates anywhere. This is the actual "merge" of what
  // used to be a separate /market page's query-param filtering. ──
  const searchInput = document.getElementById('catalogue-search')
  const filterButtons = document.querySelectorAll('.catalogue-cat-filter')
  let activeGroup = 'all'

  function applyCatalogueFilter() {
    const term = (searchInput?.value || '').toLowerCase().trim()
    const filtered = allCards.filter((card) => {
      const matchesGroup = activeGroup === 'all' || card.group === activeGroup
      const matchesSearch = !term ||
        card.material.toLowerCase().includes(term) ||
        card.spec.toLowerCase().includes(term) ||
        card.businessName.toLowerCase().includes(term)
      return matchesGroup && matchesSearch
    })
    renderCards(filtered)
  }

  searchInput?.addEventListener('input', applyCatalogueFilter)
  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeGroup = btn.dataset.group
      filterButtons.forEach((b) => b.classList.remove('active'))
      btn.classList.add('active')
      applyCatalogueFilter()
    })
  })

  loadMarketplace()

  // ── Community Validation — real data only. "People tried
  // QuoteLens" and "businesses waiting to join" aren't tracked
  // anywhere in the schema, so rather than inventing them, this
  // shows two genuinely measurable stats instead. ────────────
  let selectedRating = 0
  const starEls = document.querySelectorAll('#star-input span')

  starEls.forEach((star) => {
    star.addEventListener('click', () => {
      selectedRating = Number(star.dataset.star)
      starEls.forEach((s) => {
        s.classList.toggle('filled', Number(s.dataset.star) <= selectedRating)
      })
    })
  })

  async function loadCommunityStats() {
    const { count: opinionCount } = await supabase
      .from('community_opinions')
      .select('id', { count: 'exact', head: true })

    const statOpinions = document.getElementById('stat-opinions')
    if (statOpinions) {
      statOpinions.textContent = `${opinionCount ?? 0} opinion${opinionCount === 1 ? '' : 's'} submitted`
    }

    const { data: tenants } = await supabase
      .from('tenant_config')
      .select('completed_quotes')

    const totalQuotes = (tenants || []).reduce((sum, t) => sum + (t.completed_quotes || 0), 0)
    const statQuotes = document.getElementById('stat-quotes')
    if (statQuotes) {
      statQuotes.textContent = `${totalQuotes} quote${totalQuotes === 1 ? '' : 's'} completed across QuoteLens`
    }
  }

  async function loadRecentOpinions() {
    const listEl = document.getElementById('opinions-list')
    if (!listEl) return

    const { data, error } = await supabase
      .from('community_opinions')
      .select('name, rating, feedback_text, created_at')
      .order('created_at', { ascending: false })
      .limit(6)

    if (error || !data || data.length === 0) {
      listEl.innerHTML = `<p style="font-size:0.85rem; color:var(--ink-faint);">
        No opinions yet — be the first to share yours.
      </p>`
      return
    }

    listEl.innerHTML = data.map((o) => {
      const displayName = o.name?.trim() || 'Anonymous'
      const stars = '★'.repeat(o.rating) + '☆'.repeat(5 - o.rating)
      const text = o.feedback_text ? `<p class="opinion-text">"${escapeHtml(o.feedback_text)}"</p>` : ''
      return `
        <div class="opinion-card">
          <div class="opinion-header">
            <span class="opinion-name">${escapeHtml(displayName)}</span>
            <span class="opinion-stars">${stars}</span>
          </div>
          ${text}
        </div>
      `
    }).join('')
  }

  function escapeHtml(str) {
    const div = document.createElement('div')
    div.textContent = str
    return div.innerHTML
  }

  document.getElementById('submit-opinion')?.addEventListener('click', async () => {
    const statusEl = document.getElementById('opinion-status')
    const nameInput = document.getElementById('opinion-name')
    const textInput = document.getElementById('opinion-text')

    if (selectedRating === 0) {
      statusEl.textContent = 'Please select a star rating first.'
      statusEl.style.color = '#c0392b'
      return
    }

    statusEl.textContent = 'Submitting...'
    statusEl.style.color = 'var(--ink-faint)'

    const { error } = await supabase.from('community_opinions').insert({
      rating: selectedRating,
      feedback_text: textInput.value.trim() || null,
      name: nameInput.value.trim() || null
    })

    if (error) {
      statusEl.textContent = 'Something went wrong — please try again.'
      statusEl.style.color = '#c0392b'
      return
    }

    statusEl.textContent = 'Thank you — your opinion has been submitted.'
    statusEl.style.color = '#0f6e56'
    textInput.value = ''
    nameInput.value = ''
    selectedRating = 0
    starEls.forEach((s) => s.classList.remove('filled'))

    loadCommunityStats()
    loadRecentOpinions()
  })

  loadCommunityStats()
  loadRecentOpinions()
</script>

<style>
  .eyebrow-badge {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--gold-dark);
    background: var(--gold-pale);
    border: 1px solid var(--gold);
