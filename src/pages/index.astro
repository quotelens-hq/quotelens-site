    <!-- =====================================================
         SEARCH / FILTER BEHAVIOUR
    ====================================================== -->

    <script>
      import { supabase } from '../utils/supabase.js'

      function formatDimension(dimension) {
        if (!dimension || dimension.arg1 == null || dimension.arg2 == null) return null
        const widthM = (Number(dimension.arg1) / 1000).toFixed(2)
        const heightM = (Number(dimension.arg2) / 1000).toFixed(2)
        return `${widthM}m × ${heightM}m`
      }

      const SHOWROOM_TENANT_ID = 'showroom'

      async function loadRealMarketplace() {
        const statusEl = document.getElementById('marketplace-status')
        const emptyEl  = document.getElementById('marketplace-empty')
        const gridEl   = document.querySelector('[data-marketplace-grid]')

        const { data: tenants, error } = await supabase
          .from('tenant_config')
          .select('tenant_id, business_name, currency_symbol, marketplace_listing')
          .eq('subscription_status', 'active')
          .eq('marketplace_listed', true)
          .not('marketplace_listing', 'is', null)

        if (error) {
          statusEl.textContent = 'Could not load published catalogues right now.'
          console.error(error)
          return
        }

        // Flatten into ONE card per real, individually configured
        // product — not a per-business summary. Each product's own
        // photo, material, spec, and price render directly, the same
        // way the real quote flow itself would show them.
        const realCards = []

        ;(tenants || []).forEach((tenant) => {
          const listingsByTemplate = tenant.marketplace_listing
          if (!listingsByTemplate || typeof listingsByTemplate !== 'object') return

          const isShowroom = tenant.tenant_id === SHOWROOM_TENANT_ID

          Object.entries(listingsByTemplate).forEach(([templateId, listing]) => {
            if (!listing?.cards?.length) return

            const dimensionLabel = formatDimension(listing.dimension)

            listing.cards.forEach((card) => {
              if (!card.imageUrl) return

              realCards.push({
                tenantId: tenant.tenant_id,
                businessName: tenant.business_name,
                currencySymbol: tenant.currency_symbol || 'KSh',
                material: card.material?.label || '',
                spec: card.spec?.label || '',
                price: card.price,
                imageUrl: card.imageUrl,
                dimensionLabel,
                isShowroom
              })
            })
          })
        })

        statusEl.style.display = 'none'

        if (realCards.length === 0) {
          emptyEl.style.display = 'block'
          return
        }

        gridEl.innerHTML = realCards.map((card) => `
          <a class="marketplace-card" href="https://quote-lens.app/t/${card.tenantId}"
             data-search-text="${(card.businessName + ' ' + card.material + ' ' + card.spec).toLowerCase()}">
            <div class="marketplace-image">
              <img src="${card.imageUrl}" alt="${card.material} ${card.spec}" loading="lazy" />
            </div>
            <div class="marketplace-card-body">
              <span class="marketplace-business">
                ${card.businessName}${card.isShowroom ? ' <span class="demo-tag">DEMO</span>' : ''}
              </span>
              ${card.dimensionLabel ? `<p class="marketplace-dimension">${card.dimensionLabel}</p>` : ''}
              <h3>${card.material}</h3>
              <p>${card.spec}</p>
              <p class="marketplace-price">${card.currencySymbol} ${Number(card.price).toLocaleString()}</p>
            </div>
          </a>
        `).join('')

        // Real cards just replaced the empty grid — re-apply
        // whatever search/category state is currently active so
        // they're not shown stale/unfiltered if the user already
        // typed something while this was loading.
        filterContent()
      }

      loadRealMarketplace()

      const searchInput =
        document.querySelector("[data-global-search]");

      const catalogueCards =
        document.querySelectorAll(".catalogue-card");

      // Not captured here — real marketplace cards get injected
      // into the DOM asynchronously (after the Supabase query
      // below resolves), so a one-time querySelectorAll at script
      // load time would always be empty. filterContent() re-queries
      // this live, every time it runs, instead.

      const filterButtons =
        document.querySelectorAll(".filter-button");

      const emptyState =
        document.querySelector("[data-catalogue-empty]");

      const resetSearch =
        document.querySelector("[data-reset-search]");


      let activeCategory = "all";


      function normalise(value) {

        return (value || "")
          .toLowerCase()
          .trim();

      }


      function filterContent() {

        const query =
          normalise(searchInput?.value);


        let visibleCatalogues = 0;


        catalogueCards.forEach((card) => {

          const category =
            card.getAttribute("data-category") || "";

          const searchText =
            normalise(
              card.getAttribute(
                "data-search-text"
              )
            );


          const matchesSearch =
            !query ||
            searchText.includes(query);


          const matchesCategory =
            activeCategory === "all" ||
            category === activeCategory;


          const visible =
            matchesSearch &&
            matchesCategory;


          card.classList.toggle(
            "hidden",
            !visible
          );


          if (visible) {
            visibleCatalogues++;
          }

        });


        // Live query, not the stale capture from script load —
        // real cards may have been injected since then.
        document.querySelectorAll(".marketplace-card").forEach((card) => {

          const searchText =
            normalise(
              card.getAttribute(
                "data-search-text"
              )
            );


          const visible =
            !query ||
            searchText.includes(query);


          card.classList.toggle(
            "hidden",
            !visible
          );

        });


        emptyState?.classList.toggle(
          "visible",
          visibleCatalogues === 0
        );

      }


      searchInput?.addEventListener(
        "input",
        filterContent
      );


      filterButtons.forEach((button) => {

        button.addEventListener(
          "click",
          () => {

            activeCategory =
              button.getAttribute(
                "data-category"
              ) || "all";


            filterButtons.forEach(
              (item) => {
                item.classList.toggle(
                  "active",
                  item === button
                );
              }
            );


            filterContent();

          }
        );

      });


      resetSearch?.addEventListener(
        "click",
        () => {

          if (searchInput) {
            searchInput.value = "";
          }

          activeCategory = "all";


          filterButtons.forEach(
            (button) => {

              button.classList.toggle(
                "active",
                button.getAttribute(
                  "data-category"
                ) === "all"
              );

            }
          );


          filterContent();

        }
      );

    </script>


