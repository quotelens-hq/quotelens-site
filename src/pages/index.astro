---
import Layout from '../layouts/Layout.astro'
import Footer from '../components/Footer.astro'
---
<Layout>

  <!-- ── NAV ────────────────────────────────────────────── -->
  <nav class="nav">
    <div class="nav-inner">
      <a class="nav-brand" href="/">QuoteLens</a>
      <div class="nav-links">
        <a href="/market">Marketplace</a>
        <a class="nav-hide-sm" href="#pricing">Pricing</a>
        <a class="nav-hide-sm" href="/admin">Sign In</a>
        <a class="nav-cta" href="#pricing">Get Started</a>
      </div>
    </div>
  </nav>

  <!-- ── 1. HERO ── (paper) ─────────────────────────────── -->
  <div class="band band-paper">
    <section id="promise" style="text-align:center; padding-top: 86px;">
      <p class="eyebrow">QuoteLens</p>
      <h1>"How much?"<br />finally has an answer.</h1>
      <p style="margin-top:18px; font-size:1.2rem; max-width:580px; margin-left:auto; margin-right:auto;">
        Photo. Measurements. Products. Instant price.
      </p>
      <p style="margin-top:10px; max-width:520px; margin-left:auto; margin-right:auto; color:var(--ink-faint);">
        An instant price — before ten WhatsApp messages
        or one long phone call.
      </p>

      <div style="margin-top:34px; display:flex; gap:14px; justify-content:center; flex-wrap:wrap;">
        <a class="btn btn-primary" href="#pricing">Get Started</a>
        <a class="btn btn-ghost" href="/market">Browse Marketplace</a>
      </div>
    </section>
  </div>

  <!-- ── 2. THE PROBLEM ── (tint) ───────────────────────── -->
  <div class="band band-tint">
    <section id="problem" style="text-align:center;">
      <p class="eyebrow">The Problem</p>
      <h2>Your WhatsApp shouldn't be<br />your sales process.</h2>
      <p style="margin-top:14px; max-width:560px; margin-left:auto; margin-right:auto;">
        Every made-to-measure advert ends the same way:
        <strong>"Message us on WhatsApp."</strong><br />
        Then anything can arrive.
      </p>

      <ul class="chaos-list">
        <li>The same price question, again</li>
        <li>Enquiries that go nowhere</li>
        <li>Unrelated requests</li>
        <li>Time wasters</li>
        <li>Genuine customers mixed with everyone else</li>
      </ul>

      <p style="margin-top:28px; font-weight:600; color:var(--ink);">
        QuoteLens changes where the conversation begins.
      </p>
    </section>
  </div>

  <!-- ── 3. THE DIFFERENCE ── (white) ───────────────────── -->
  <div class="band band-white">
    <section id="difference" style="text-align:center;">
      <p class="eyebrow">The Difference</p>
      <h2>Every customer arrives prepared.</h2>
      <p style="margin-top:14px; max-width:520px; margin-left:auto; margin-right:auto;">
        Before a customer reaches your business, they have already:
      </p>

      <div class="prepared-list">
        <p>✓ Explored your products</p>
        <p>✓ Confirmed their measurements</p>
        <p>✓ Received an instant quote</p>
      </div>

      <p style="margin-top:26px; font-size:1.1rem; font-weight:600; color:var(--ink);">
        When the message finally arrives,<br />
        the conversation can begin.
      </p>
    </section>
  </div>

  <!-- ── 4. HOW IT WORKS ── (tint) ──────────────────────── -->
  <div class="band band-tint">
    <section id="how" style="text-align:center;">
      <p class="eyebrow">How It Works</p>

      <div class="journey">
        <div class="journey-step">Customer discovers your business</div>
        <div class="journey-arrow">↓</div>
        <div class="journey-step">Explores your products</div>
        <div class="journey-arrow">↓</div>
        <div class="journey-step">Confirms measurements</div>
        <div class="journey-arrow">↓</div>
        <div class="journey-step">Receives an instant quote</div>
        <div class="journey-arrow">↓</div>
        <div class="journey-step gold">A prepared customer, delivered to WhatsApp &amp; email</div>
      </div>

      <p class="timer">⏱ Average journey — 4 minutes</p>
    </section>
  </div>

  <!-- ── 5. BUILT FOR CUSTOM PRODUCTS ── (white) ────────── -->
  <div class="band band-white">
    <section id="industries" style="text-align:center;">
      <h2>Built for custom products.</h2>

      <div class="industry-grid">
        <div>Curtains</div>
        <div>Blinds</div>
        <div>Wooden Doors</div>
        <div>Steel Doors</div>
        <div>Gates</div>
        <div>Garage Doors</div>
        <div>Kitchen Islands</div>
        <div>Plantation Shutters</div>
        <div class="more">+ More</div>
      </div>

      <p style="margin-top:26px; font-weight:600; color:var(--ink);">
        If your product starts with "What size?" — QuoteLens can sell it.
      </p>
    </section>
  </div>

  <!-- ── 6. ONE LINK ── (tint) ──────────────────────────── -->
  <div class="band band-tint">
    <section id="onelink" style="text-align:center;">
      <h2>One link.<br />Every customer.</h2>

      <div class="channel-row">
        <span>Instagram</span>
        <span>Facebook</span>
        <span>TikTok</span>
        <span>WhatsApp</span>
        <span>Google Business</span>
        <span>Jiji</span>
        <span>QR Code</span>
      </div>

      <p class="funnel-arrow">↓</p>
      <p class="funnel-node">Your QuoteLens page</p>
      <p class="funnel-arrow">↓</p>
      <p class="funnel-line">
        Every customer follows the same professional journey.
      </p>
      <p class="funnel-arrow">↓</p>
      <p class="funnel-node gold">A prepared customer, delivered</p>
    </section>
  </div>

  <!-- ── 7. MARKETPLACE ── (white) ──────────────────────── -->
  <div class="band band-white">
    <section id="marketplace" style="text-align:center;">
      <p class="eyebrow">Marketplace</p>
      <h2>Made-to-measure products<br />are finally shoppable.</h2>
      <p style="margin-top:14px; max-width:520px; margin-left:auto; margin-right:auto;">
        Browse products from businesses using QuoteLens.
      </p>

      <div class="shop-steps">
        <span>Choose a product</span>
        <span class="shop-arrow">→</span>
        <span>Configure it to your measurements</span>
        <span class="shop-arrow">→</span>
        <span>Receive an instant quote</span>
      </div>

      <div style="margin-top:30px;">
        <a class="btn btn-ghost" href="/market">Browse Marketplace</a>
      </div>
    </section>
  </div>

  <!-- ── 8. PRICING ── (tint) ───────────────────────────── -->
  <div class="band band-tint">
    <section id="pricing" style="text-align:center;">
      <p class="eyebrow">Pricing</p>
      <h2>Simple pricing. Pay with M-Pesa.</h2>

      <div class="plans">
        <div class="price-card">
          <p class="plan-name">QuoteLens Starter</p>
          <p class="price">KSh 2,500<span>/month</span></p>
          <p class="plan-tag">Perfect for businesses getting started.</p>
          <ul>
            <li>Your own quote page</li>
            <li>Unlimited customer quotes</li>
            <li>Marketplace listing</li>
            <li>Manual measurements</li>
            <li>WhatsApp &amp; email delivery</li>
            <li>Business dashboard</li>
          </ul>
          <a class="btn btn-primary" href="/join" style="width:100%; text-align:center;">Get Started</a>
        </div>

        <div class="price-card">
          <p class="plan-name">QuoteLens Growth</p>
          <p class="price">KSh 5,500<span>/month</span></p>
          <p class="plan-tag">Everything in Starter, plus:</p>
          <ul>
            <li>AI measurements — customers photograph, QuoteLens estimates</li>
            <li>Higher AI usage</li>
          </ul>
          <a class="btn btn-primary" href="/join" style="width:100%; text-align:center;">Get Started</a>
        </div>
      </div>

      <p style="margin-top:18px; font-weight:600; color:var(--gold-dark);">
        Less than the cost of one unnecessary site visit.
      </p>
      <p class="trust-strip">
        Pay with M-Pesa · Cancel anytime
      </p>
    </section>
  </div>

  <!-- ── 9. FAQ ── (white) ──────────────────────────────── -->
  <div class="band band-white">
    <section id="faq">
      <h2 style="text-align:center;">Frequently asked questions</h2>

      <div class="faq-list">
        <details>
          <summary>Does QuoteLens replace WhatsApp?</summary>
          <p>No. Your customers still reach you on WhatsApp — they just
          arrive prepared: measurements confirmed, product chosen, price
          already seen. The conversation starts where it used to end.</p>
        </details>
        <details>
          <summary>Do customers install an app?</summary>
          <p>No. They tap your link — from an advert, your bio, or the
          QuoteLens Marketplace — and it opens in their browser.</p>
        </details>
        <details>
          <summary>What do I get for KSh 2,500 a month?</summary>
          <p>Your own quote page, unlimited customer quotes, your products
          listed on the QuoteLens Marketplace, and every enquiry delivered
          to WhatsApp and email with the details already gathered.</p>
        </details>
        <details>
          <summary>What's different on Growth?</summary>
          <p>AI measurements — your customers photograph their window or
          door and QuoteLens estimates the size for them — plus higher AI
          usage. On Starter, customers enter measurements manually, which
          works fully; Growth removes even that step.</p>
        </details>
        <details>
          <summary>How do I pay?</summary>
          <p>M-Pesa. Choose your plan, pay, and your account is live.
          Cancel anytime — your page simply stops at the end of the paid
          period.</p>
        </details>
        <details>
          <summary>Can I change my prices?</summary>
          <p>Yes, any time, from your dashboard. New quotes use your new
          rates immediately.</p>
        </details>
        <details>
          <summary>Can I try it before paying?</summary>
          <p>Yes — as a customer. Browse the Marketplace and walk a quote
          journey yourself. What you experience there is exactly what your
          customers will experience on your page.</p>
        </details>
        <details>
          <summary>What businesses is QuoteLens for?</summary>
          <p>Any business pricing custom work — anything that starts with
          "what size?" Curtains, doors, gates, kitchens, and more.</p>
        </details>
      </div>
    </section>
  </div>

  <!-- ── 10. FINAL CTA ── (dark) ────────────────────────── -->
  <div class="final-band">
    <p>Every great customer conversation<br />starts before WhatsApp.</p>
    <p style="margin-top:14px; font-size:1.05rem; font-weight:400; color:#cfc9bf;">
      QuoteLens prepares every customer before they reach your business.<br />
      When the message finally arrives, it's the right conversation.
    </p>
    <div style="margin-top:26px; display:flex; gap:14px; justify-content:center; flex-wrap:wrap;">
      <a class="btn btn-primary" href="#pricing">Get Started</a>
      <a class="btn btn-ghost-dark" href="/market">Browse Marketplace</a>
    </div>
  </div>

  <Footer />

</Layout>

<style>
  .chaos-list {
    list-style: none;
    margin: 30px auto 0;
    max-width: 420px;
    text-align: left;
  }
  .chaos-list li {
    background: #f4f2ee;
    border: 1px solid #e4e0d8;
    border-radius: 10px;
    padding: 12px 18px;
    margin-bottom: 8px;
    font-weight: 600;
    color: var(--ink-soft);
    font-size: 0.98rem;
  }

  .prepared-list {
    margin: 26px auto 0;
    max-width: 340px;
  }
  .prepared-list p {
    background: var(--gold-pale);
    border: 1px solid var(--gold);
    border-radius: 10px;
    padding: 12px 18px;
    margin-bottom: 8px;
    font-weight: 700;
    color: var(--gold-dark);
    font-size: 1rem;
  }

  .journey {
    margin: 40px auto 0;
    max-width: 400px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .journey-step {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 18px;
    font-weight: 600;
    font-size: 0.98rem;
  }
  .journey-step.gold {
    background: var(--gold-pale);
    border-color: var(--gold);
    color: var(--gold-dark);
  }
  .journey-arrow { color: var(--gold); font-weight: 700; }
  .timer {
    margin-top: 24px;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--gold-dark);
  }

  .industry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 10px;
    margin-top: 36px;
  }
  .industry-grid div {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 16px 10px;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .industry-grid .more {
    background: var(--gold-pale);
    border-color: var(--gold);
    color: var(--gold-dark);
  }

  .channel-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-top: 34px;
  }
  .channel-row span {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 8px 16px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .funnel-arrow {
    color: var(--gold);
    font-weight: 700;
    margin: 10px 0;
    font-size: 1.2rem;
  }
  .funnel-node {
    display: inline-block;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 26px;
    font-weight: 700;
    color: var(--ink);
  }
  .funnel-node.gold {
    background: var(--gold-pale);
    border-color: var(--gold);
    color: var(--gold-dark);
  }
  .funnel-line { color: var(--ink-soft); font-size: 1rem; }

  .shop-steps {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    align-items: center;
    margin-top: 30px;
  }
  .shop-steps span {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 18px;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink);
  }
  .shop-steps .shop-arrow {
    background: none;
    border: none;
    color: var(--gold);
    font-weight: 700;
    padding: 0;
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
    margin-top: 36px;
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
    align-items: start;
  }
  .price-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 28px 24px;
    text-align: left;
  }
  .plan-name {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    text-align: center;
  }
  .price { font-size: 2.2rem; font-weight: 800; color: var(--ink); text-align: center; margin-top: 4px; }
  .price span { font-size: 1rem; font-weight: 600; color: var(--ink-faint); }
  .plan-tag {
    text-align: center;
    font-size: 0.88rem;
    color: var(--ink-faint);
    margin-top: 4px;
  }
  .price-card ul { list-style: none; margin: 18px 0 22px; padding: 0; }
  .price-card li {
    padding: 7px 0;
    color: var(--ink-soft);
    border-bottom: 1px solid var(--border);
    font-size: 0.95rem;
  }
  .price-card li::before { content: "✓ "; color: var(--gold); font-weight: 700; }

  .trust-strip {
    margin-top: 22px;
    font-size: 0.88rem;
    color: var(--ink-faint);
  }

  .faq-list { max-width: 680px; margin: 32px auto 0; }
  .faq-list details {
    border-bottom: 1px solid var(--border);
    padding: 16px 0;
  }
  .faq-list summary {
    font-weight: 700;
    color: var(--ink);
    cursor: pointer;
    font-size: 1rem;
    list-style: none;
  }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary::after {
    content: "+";
    float: right;
    color: var(--gold);
    font-weight: 700;
  }
  .faq-list details[open] summary::after { content: "−"; }
  .faq-list details p { margin-top: 10px; font-size: 0.97rem; }

  .final-band {
    background: var(--ink);
    text-align: center;
    padding: 74px 20px;
    margin-top: 0;
  }
  .final-band p {
    color: #fff;
    font-size: clamp(1.2rem, 3.5vw, 1.7rem);
    font-weight: 700;
  }
  .btn-ghost-dark {
    display: inline-block;
    padding: 15px 30px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    background: transparent;
    color: #fff;
    border: 2px solid #555;
  }
  .btn-ghost-dark:hover { border-color: var(--gold); color: var(--gold-pale); }
</style>
