---
import { catalogues } from "../data/catalogues";

const categories = [
  "All",
  "Food",
  "Fashion",
  "Home Improvement",
  "Furniture",
  "Automotive",
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>QuoteLens — Specification-driven buying for custom products</title>
    <meta name="description" content="QuoteLens brings specification-driven buying to the fragmented world of custom and made-to-order products." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>

  <body>

    <!-- =====================================================
         NAVIGATION — unchanged, full width, same as before
    ====================================================== -->

    <header class="site-header">
      <div class="nav-inner">
        <a href="/" class="brand" aria-label="QuoteLens home">
          <span class="brand-mark">Q</span>
          <span>QuoteLens</span>
        </a>
        <nav class="desktop-nav">
          <a href="#catalogues">Catalogues</a>
          <a href="#how-it-works">How it works</a>
          <a href="#marketplace">Marketplace</a>
        </nav>
        <div class="nav-actions">
          <a href="/admin" class="signin-link">Sign in</a>
          <a href="/join" class="nav-cta">Publish your catalogue</a>
        </div>
      </div>
    </header>


    <main>

      <!-- =====================================================
           TWO-COLUMN LAYOUT — the whole page, per the sketch.
           Left: every section's headline/pitch, condensed into
           stacked boxes. Right: catalogue cards, then the real
           marketplace search + grid. Not repeated per-section —
           one continuous split for the entire page.
      ====================================================== -->

      <div class="two-col-layout">

        <!-- ── LEFT COLUMN ── -->
        <div class="left-col">

          <!-- Hero pitch — kept as full content, not boxed,
               matches the sketch's unboxed top item -->
          <div class="hero-pitch">
            <div class="eyebrow">
              <span class="eyebrow-dot"></span>
              Specification-driven buying
            </div>
            <h1>
              Know what
              <span>you want.</span>
              <strong>Know what it costs.</strong>
            </h1>
            <p class="hero-description">
              QuoteLens brings specification-driven buying to the
              fragmented world of custom and made-to-order products.
            </p>
            <div class="hero-actions">
              <a href="#catalogues" class="button button-dark">
                <span>Explore products</span>
                <span>→</span>
              </a>
              <a href="/join" class="button button-light">
                Publish your catalogue
              </a>
            </div>
          </div>

          <!-- Box 1 — condensed Thesis content -->
          <div class="pitch-box">
            <h3>Specification-driven buying</h3>
            <p>
              Custom buying traditionally starts with an explanation
              and ends with a conversation about price. QuoteLens
              flips that: Specify → Discover → Compare → Enquire.
            </p>
          </div>

          <!-- Box 2 — condensed How It Works content -->
          <div class="pitch-box">
            <h3>Buying custom products shouldn't feel complicated.</h3>
            <p>
              Discover a business. Configure your requirements.
              Compare what fits. Send a prepared enquiry.
            </p>
          </div>

          <!-- Box 3 — condensed Business content -->
          <div class="pitch-box dark">
            <h3>Turn your products into structured buying.</h3>
            <p>
              Configure once. Customers arrive with useful
              specifications already attached — spend less time
              explaining, more time delivering.
            </p>
            <a href="/join" class="button button-dark small">
              Publish your catalogue <span>→</span>
            </a>
          </div>

          <!-- Box 4 — condensed Community content -->
          <div class="pitch-box">
            <h3>Community Validation</h3>
            <p>Was QuoteLens useful? Tell us what you think.</p>
            <a href="/community" class="box-link">Share your experience →</a>
          </div>

        </div>


        <!-- ── RIGHT COLUMN ── -->
        <div class="right-col">

          <!-- Catalogue cards — real data, compact grid -->
          <div id="catalogues" class="right-block">
            <p class="right-block-label">EXPLORE CATALOGUES</p>
            <div class="catalogue-grid-compact">
              {
                catalogues.slice(0, 6).map((catalogue) => (
                  <a href={catalogue.publishUrl} class="mini-catalogue-card">
                    {
                      catalogue.image ? (
                        <>
                          <img
                            src={catalogue.image}
                            alt={catalogue.title}
                            loading="lazy"
                            onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
                          />
                          <div class="mini-image-placeholder" style="display:none;">
                            <span>{catalogue.experience.icon}</span>
                          </div>
                        </>
                      ) : (
                        <div class="mini-image-placeholder">
                          <span>{catalogue.experience.icon}</span>
                        </div>
                      )
                    }
                    <div class="mini-card-body">
                      <span style={`color:${catalogue.experience.color};`}>
                        {catalogue.category}
                      </span>
                      <strong>{catalogue.title}</strong>
                    </div>
                  </a>
                ))
              }
            </div>
            <a href="#catalogues" class="box-link">See all catalogues →</a>
          </div>

          <!-- Marketplace — real search + real, capped preview.
               Full pagination lives on /marketplace, linked below. -->
          <div id="marketplace" class="right-block">
            <p class="right-block-label">FIND SOMETHING THAT FITS</p>
            <h3>your specification</h3>

            <div class="mini-search">
              <span>⌕</span>
              <input
                type="search"
                id="mini-marketplace-search"
                placeholder="Search marketplace..."
              />
            </div>

            <div id="marketplace-status" class="marketplace-status">
              Loading published catalogues...
            </div>
            <div id="marketplace-empty" class="marketplace-empty" style="display:none;">
              No businesses have published a catalogue yet.
              <a href="/join">Publish your catalogue →</a>
            </div>

            <div class="mini-marketplace-grid" data-marketplace-grid></div>

            <a href="/marketplace" class="box-link">
              Browse the full marketplace →
            </a>
          </div>

        </div>

      </div>

    </main>


    <!-- =====================================================
         FOOTER — unchanged, full width
    ====================================================== -->

    <footer class="site-footer">
      <div class="section-container">
        <div class="footer-main">
          <div class="footer-brand">
            <a href="/" class="brand footer-logo">
              <span class="brand-mark">Q</span>
              <span>QuoteLens</span>
            </a>
            <p>Specification-driven buying for custom and made-to-order products.</p>
          </div>
          <div class="footer-links">
            <div>
              <span>EXPLORE</span>
              <a href="#catalogues">Catalogues</a>
              <a href="#how-it-works">How it works</a>
              <a href="/marketplace">Marketplace</a>
            </div>
            <div>
              <span>FOR BUSINESSES</span>
              <a href="/join">Publish</a>
              <a href="/admin">Sign in</a>
              <a href="/pricing">Pricing</a>
            </div>
            <div>
              <span>COMMUNITY</span>
              <a href="/community">Community</a>
              <a href="/help">Help</a>
            </div>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} QuoteLens</span>
          <span>Built for better buying conversations.</span>
        </div>
      </div>
    </footer>


    <!-- =====================================================
         REAL MARKETPLACE DATA — capped preview here (6 real
         cards), full set lives on /marketplace.
    ====================================================== -->

    <script>
      import { supabase } from '../utils/supabase.js'

      const PREVIEW_LIMIT = 8

      const CATEGORY_META = {
        cakes:                { category: 'Food',              icon: '🎂' },
        flowers:               { category: 'Food',              icon: '💐' },
        womens_dresses:         { category: 'Fashion',           icon: '👗' },
        vehicle_parts:          { category: 'Automotive',        icon: '🔧' },
        plantation_shutters:    { category: 'Home Improvement',  icon: '🪟' },
        curtains:               { category: 'Home Improvement',  icon: '🪟' },
        wooden_doors:           { category: 'Home Improvement',  icon: '🚪' },
        steel_doors:            { category: 'Home Improvement',  icon: '🛡️' },
        gates:                  { category: 'Home Improvement',  icon: '🚪' },
        garage_doors:           { category: 'Home Improvement',  icon: '🚗' },
        kitchen_island:         { category: 'Furniture',         icon: '🍽️' },
        blinds:                 { category: 'Home Improvement',  icon: '🪟' }
      }

      const SHOWROOM_TENANT_ID = 'showroom'
      let allRealCards = []

      async function loadMarketplacePreview() {
        const statusEl = document.getElementById('marketplace-status')
        const emptyEl  = document.getElementById('marketplace-empty')
        const gridEl   = document.querySelector('[data-marketplace-grid]')

        // Fetching everything is the current honest limitation —
        // the JSONB-per-tenant model means we can't ask the
        // database for "just 6 cards" directly. This is fine at
        // today's real scale; a proper products table would be
        // needed for true server-side pagination at real volume.
        const { data: tenants, error } = await supabase
          .from('tenant_config')
          .select('tenant_id, business_name, currency_symbol, marketplace_listing')
          .eq('subscription_status', 'active')
          .eq('marketplace_listed', true)
          .not('marketplace_listing', 'is', null)

        if (error) {
          statusEl.textContent = 'Could not load published catalogues right now.'
          console.error(error)
          return
        }

        ;(tenants || []).forEach((tenant) => {
          const listingsByTemplate = tenant.marketplace_listing
          if (!listingsByTemplate || typeof listingsByTemplate !== 'object') return
          const isShowroom = tenant.tenant_id === SHOWROOM_TENANT_ID

          Object.entries(listingsByTemplate).forEach(([templateId, listing]) => {
            if (!listing?.cards?.length) return
            const meta = CATEGORY_META[templateId] || { category: 'Other', icon: '📦' }

            listing.cards.forEach((card) => {
              if (!card.imageUrl) return
              allRealCards.push({
                tenantId: tenant.tenant_id,
                businessName: tenant.business_name,
                currencySymbol: tenant.currency_symbol || 'KSh',
                material: card.material?.label || '',
                spec: card.spec?.label || '',
                price: card.price,
                imageUrl: card.imageUrl,
                category: meta.category,
                icon: meta.icon,
                isShowroom,
                searchText: (tenant.business_name + ' ' + (card.material?.label || '') + ' ' + (card.spec?.label || '')).toLowerCase()
              })
            })
          })
        })

        statusEl.style.display = 'none'

        if (allRealCards.length === 0) {
          emptyEl.style.display = 'block'
          return
        }

        renderPreview(allRealCards.slice(0, PREVIEW_LIMIT))
      }

      function renderPreview(cards) {
        const gridEl = document.querySelector('[data-marketplace-grid]')
        if (cards.length === 0) {
          gridEl.innerHTML = `<p style="font-size:12px; color:#756e65;">No matches — try a different search.</p>`
          return
        }
        gridEl.innerHTML = cards.map((card) => `
          <a href="https://quote-lens.app/t/${card.tenantId}" class="mini-market-card">
            <img src="${card.imageUrl}" alt="${card.material}" loading="lazy" />
            <div>
              <span class="mini-market-business">${card.businessName}${card.isShowroom ? ' · DEMO' : ''}</span>
              <strong>${card.material}</strong>
              <span class="mini-market-price">${card.currencySymbol} ${Number(card.price).toLocaleString()}</span>
            </div>
          </a>
        `).join('')
      }

      document.getElementById('mini-marketplace-search')?.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim()
        const filtered = query
          ? allRealCards.filter(c => c.searchText.includes(query))
          : allRealCards.slice(0, PREVIEW_LIMIT)
        renderPreview(filtered)
      })

      loadMarketplacePreview()
    </script>


    <!-- =====================================================
         STYLES
    ====================================================== -->

    <style>

      :global(*) { box-sizing: border-box; }
      :global(html) { scroll-behavior: smooth; }
      :global(body) {
        margin: 0;
        background: #f7f4ed;
        color: #181714;
        font-family: "Manrope", sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      :global(a) { color: inherit; text-decoration: none; }
      :global(button), :global(input) { font: inherit; }
      :global(button) { cursor: pointer; }

      .section-container {
        width: min(1180px, calc(100% - 80px));
        margin: 0 auto;
      }

      /* ── NAV (unchanged) ── */
      .site-header {
        position: sticky; top: 0; z-index: 50;
        background: rgba(247, 244, 237, 0.92);
        backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(24, 23, 20, 0.09);
      }
      .nav-inner {
        width: min(1180px, calc(100% - 80px));
        height: 70px; margin: 0 auto;
        display: flex; align-items: center; justify-content: space-between; gap: 30px;
      }
      .brand { display: inline-flex; align-items: center; gap: 10px; font-size: 17px; font-weight: 800; letter-spacing: -0.04em; }
      .brand-mark {
        width: 30px; height: 30px; display: grid; place-items: center;
        border-radius: 8px; background: #181714; color: #fff; font-size: 13px; font-weight: 800;
      }
      .desktop-nav { display: flex; align-items: center; gap: 34px; margin-left: auto; margin-right: auto; }
      .desktop-nav a, .signin-link { color: #68645d; font-size: 13px; font-weight: 600; transition: color 0.2s ease; }
      .desktop-nav a:hover, .signin-link:hover { color: #181714; }
      .nav-actions { display: flex; align-items: center; gap: 20px; }
      .nav-cta {
        padding: 12px 18px; border-radius: 999px; background: #181714; color: white;
        font-size: 12px; font-weight: 800; transition: transform 0.2s ease, background 0.2s ease;
      }
      .nav-cta:hover { transform: translateY(-1px); background: #2b2924; }

      .eyebrow {
        display: flex; align-items: center; gap: 9px;
        color: #b27c19; font-size: 11px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase;
      }
      .eyebrow-dot { width: 6px; height: 6px; border-radius: 50%; background: #b27c19; }

      .button {
        min-height: 44px; padding: 0 18px; display: inline-flex; align-items: center; justify-content: center;
        gap: 14px; border-radius: 999px; font-size: 13px; font-weight: 800;
        transition: transform 0.2s ease, background 0.2s ease;
      }
      .button:hover { transform: translateY(-2px); }
      .button-dark { background: #181714; color: white; }
      .button-dark:hover { background: #292823; }
      .button-light { border: 1px solid #d9d2c5; background: transparent; }
      .button.small { min-height: 38px; padding: 0 14px; font-size: 12px; gap: 10px; margin-top: 14px; }

      /* ── TWO-COLUMN LAYOUT ── */
      .two-col-layout {
        width: min(1300px, calc(100% - 80px));
        margin: 0 auto;
        display: grid;
        grid-template-columns: 0.85fr 1.15fr;
        gap: 70px;
        padding: 90px 0 140px;
        align-items: start;
      }

      .left-col, .right-col {
        display: flex;
        flex-direction: column;
        gap: 40px;
      }

      /* Hero pitch — unboxed top item */
      .hero-pitch h1 {
        margin: 24px 0 22px;
        font-size: clamp(38px, 4.2vw, 56px);
        line-height: 0.98;
        letter-spacing: -0.05em;
        font-weight: 800;
      }
      .hero-pitch h1 span { display: block; }
      .hero-pitch h1 strong { display: block; color: #817b72; font-weight: 800; }
      .hero-description {
        max-width: 460px; margin: 0; color: #655f57;
        font-size: 15px; line-height: 1.75; letter-spacing: -0.01em;
      }
      .hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }

      /* Left-column condensed boxes */
      .pitch-box {
        padding: 34px 30px;
        border: 1px solid #e0d9cf;
        border-radius: 20px;
        background: #fff;
      }
      .pitch-box.dark {
        background: #181714;
        color: #fff;
        border-color: #181714;
      }
      .pitch-box.dark p { color: #aaa69f; }
      .pitch-box h3 {
        margin: 0 0 12px;
        font-size: 21px;
        letter-spacing: -0.03em;
        line-height: 1.25;
      }
      .pitch-box p {
        margin: 0;
        color: #736c63;
        font-size: 13.5px;
        line-height: 1.75;
      }
      .box-link {
        display: inline-block;
        margin-top: 16px;
        color: #181714;
        font-size: 12px;
        font-weight: 800;
      }
      .pitch-box.dark .box-link { color: #fff; }

      /* Right column blocks */
      .right-block {
        padding: 32px;
        border: 1px solid #e0d9cf;
        border-radius: 20px;
        background: #fffdfa;
      }
      .right-block-label {
        margin: 0 0 8px;
        color: #b27c19;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.14em;
      }
      .right-block h3 {
        margin: 0 0 16px;
        font-size: 20px;
        letter-spacing: -0.03em;
      }

      .catalogue-grid-compact {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
        margin: 14px 0 18px;
      }
      .mini-catalogue-card {
        display: block;
        overflow: hidden;
        border-radius: 16px;
        border: 1px solid #e6e0d6;
        background: #fff;
        transition: transform 0.2s ease;
      }
      .mini-catalogue-card:hover { transform: translateY(-3px); }
      .mini-catalogue-card img,
      .mini-image-placeholder {
        width: 100%;
        height: 190px;
        object-fit: cover;
        display: block;
      }
      .mini-image-placeholder {
        display: grid;
        place-items: center;
        background: #f0ebe2;
        font-size: 44px;
      }
      .mini-card-body { padding: 20px 22px; }
      .mini-card-body span {
        display: block;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 7px;
      }
      .mini-card-body strong {
        font-size: 20px;
        letter-spacing: -0.03em;
      }

      .mini-search {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 16px;
        border: 1px solid #ddd6cb;
        border-radius: 12px;
        background: #fff;
        margin-bottom: 18px;
      }
      .mini-search span { color: #938b81; font-size: 16px; }
      .mini-search input {
        flex: 1; min-width: 0; border: 0; outline: 0;
        background: transparent; font-size: 13px; color: #181714;
      }

      .marketplace-status, .marketplace-empty {
        font-size: 12px;
        color: #756e65;
        padding: 10px 0;
      }
      .marketplace-empty a {
        display: block;
        margin-top: 4px;
        color: #181714;
        font-weight: 800;
      }

      /* Preview cards, 4 shown at 2-per-row rather than 6 at
         3-per-row — same real data, genuinely more room per card
         instead of feeling like a token afterthought. */
      :global(.mini-marketplace-grid) {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
        margin-bottom: 18px;
      }
      :global(.mini-market-card) {
        display: block;
        overflow: hidden;
        border-radius: 14px;
        border: 1px solid #e6e0d6;
        background: #fff;
        transition: transform 0.2s ease;
      }
      :global(.mini-market-card:hover) { transform: translateY(-2px); }
      :global(.mini-market-card img) {
        width: 100%;
        height: 130px;
        object-fit: cover;
        display: block;
      }
      :global(.mini-market-card > div) { padding: 12px 14px; }
      :global(.mini-market-business) {
        display: block;
        font-size: 8px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #b27c19;
        margin-bottom: 3px;
      }
      :global(.mini-market-card strong) {
        display: block;
        font-size: 13px;
        margin: 3px 0;
        color: #181714;
      }
      :global(.mini-market-price) {
        display: block;
        font-size: 12px;
        font-weight: 800;
        color: #181714;
        margin-top: 2px;
      }

      /* ── FOOTER (unchanged) ── */
      .site-footer { padding: 70px 0 25px; background: #181714; color: white; }
      .footer-main { display: grid; grid-template-columns: 1fr 1fr; gap: 100px; }
      .footer-logo { color: white; }
      .footer-brand p { max-width: 310px; margin-top: 20px; color: #77736c; font-size: 12px; line-height: 1.7; }
      .footer-links { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
      .footer-links > div { display: flex; flex-direction: column; gap: 12px; }
      .footer-links span { margin-bottom: 6px; color: #77736c; font-size: 9px; font-weight: 800; letter-spacing: 0.1em; }
      .footer-links a { color: #c2beb8; font-size: 11px; }
      .footer-links a:hover { color: white; }
      .footer-bottom {
        display: flex; justify-content: space-between; margin-top: 70px; padding-top: 20px;
        border-top: 1px solid #37352f; color: #68645d; font-size: 9px;
      }

      /* ── RESPONSIVE ── */
      @media (max-width: 900px) {
        .nav-inner, .two-col-layout, .section-container { width: min(100% - 40px, 700px); }
        .desktop-nav { display: none; }
        .two-col-layout { grid-template-columns: 1fr; gap: 40px; padding: 50px 0 80px; }
        .footer-main { grid-template-columns: 1fr; gap: 40px; }
      }

      @media (max-width: 600px) {
        .nav-inner, .two-col-layout, .section-container { width: calc(100% - 30px); }
        .signin-link { display: none; }
        .catalogue-grid-compact { grid-template-columns: 1fr; }
        :global(.mini-marketplace-grid) { grid-template-columns: 1fr; }
        .footer-links { grid-template-columns: 1fr 1fr; }
        .footer-bottom { flex-direction: column; gap: 8px; }
      }

    </style>

  </body>
</html>


