   <style>
  /* =========================================================
     QUOTELENS — PREMIUM VISUAL SYSTEM
     Styling only.
     Existing markup + functionality remain unchanged.
  ========================================================= */
 
  :global(*) {
    box-sizing: border-box;
  }
 
  :global(html) {
    scroll-behavior: smooth;
    background: #f5f2eb;
  }
 
  :global(body) {
    margin: 0;
    background:
      radial-gradient(
        circle at 72% 8%,
        rgba(184, 134, 42, 0.055),
