---
import Layout from "../layouts/Layout.astro";
import { catalogues } from "../data/catalogues";
---

<Layout
  title="QuoteLens — Specification-driven buying"
  description="QuoteLens brings specification-driven buying to the fragmented world of custom and made-to-order products."
>

  <div class="site">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="site-header">

      <a href="/" class="brand">
        <span class="brand-mark">Q</span>
        <span class="brand-name">QuoteLens</span>
      </a>

      <nav class="main-nav">

        <a href="#catalogues">
          Catalogues
        </a>

        <a href="#how-it-works">
          How it works
        </a>

        <a href="#marketplace">
          Marketplace
        </a>

      </nav>

      <div class="header-actions">

        <a
          href="/signin"
          class="signin-link"
        >
          Sign in
        </a>

        <a
          href="/join"
          class="publish-button"
        >
          Publish your catalogue
        </a>

      </div>

    </header>


    <!-- =====================================================
         MAIN EXPERIENCE
    ====================================================== -->

    <main class="main-layout">

      <!-- ===================================================
           LEFT EDITORIAL PANEL
      ==================================================== -->

      <aside class="editorial-panel">

        <div class="editorial-inner">

          <div class="eyebrow">
            Specification-driven buying
          </div>

          <h1>
            Know what
            <br />
            <span>you want.</span>

            <strong>
              Know what it
              <br />
              costs.
            </strong>
          </h1>

          <p class="hero-description">
            QuoteLens brings specification-driven buying
            to the fragmented world of custom and
            made-to-order products.
          </p>

          <div class="hero-actions">

            <a
              href="#catalogues"
              class="primary-button"
            >
              <span>Explore products</span>
              <span>→</span>
            </a>

            <a
              href="/join"
              class="secondary-button"
            >
              Publish your catalogue
            </a>

          </div>

          <p class="hero-note">
            Built for products that require customer
            specifications before purchase.
          </p>

        </div>

      </aside>


      <!-- ===================================================
           RIGHT CONTENT
      ==================================================== -->

      <div class="content-panel">


        <!-- =================================================
             CUSTOMER JOURNEY INTRO
        ================================================== -->

        <section class="journey-section">

          <div class="journey-window">

            <div class="window-top">

              <div class="window-dots">
                <span></span>
                <span></span>
                <span></span>
              </div>

              <span class="window-label">
                QuoteLens
              </span>

            </div>


            <div class="journey-content">

              <div class="journey-eyebrow">
                Customer journey
              </div>

              <h2>
                Find something
                <br />
                that fits.
              </h2>


              <div class="journey-steps">

                <div>
                  <small>01</small>
                  <span>Discover</span>
                </div>

                <div>
                  <small>02</small>
                  <span>Configure</span>
                </div>

                <div>
                  <small>03</small>
                  <span>Compare</span>
                </div>

                <div>
                  <small>04</small>
                  <span>Enquire</span>
                </div>

              </div>


              <div class="journey-product">

                <div class="journey-product-icon">
                  🪟
                </div>

                <div class="journey-product-copy">

                  <small>
                    Home Improvement
                  </small>

                  <strong>
                    Plantation Shutters
                  </strong>

                  <span>
                    Configure your options
                  </span>

                </div>

                <span class="journey-arrow">
                  →
                </span>

              </div>


              <div class="journey-specs">

                <div>
                  <small>Dimension</small>
                  <strong>1,500 × 1,200</strong>
                </div>

                <div>
                  <small>Material</small>
                  <strong>Cypress</strong>
                </div>

                <div>
                  <small>Finish</small>
                  <strong>Painted</strong>
                </div>

              </div>

            </div>

          </div>

        </section>


        <!-- =================================================
             IDEA
        ================================================== -->

        <section class="idea-section">

          <div class="section-label">
            The QuoteLens idea
          </div>

          <h2>
            Specification-driven buying
            <span>
              for products that don't come off a shelf.
            </span>
          </h2>

          <p class="section-lead">
            Custom buying traditionally starts with an
            explanation and ends with a conversation about price.
          </p>


          <div class="comparison">

            <div class="comparison-card">

              <span class="comparison-number">
                Traditional custom buying
              </span>

              <div class="comparison-flow">
                Explain
                <span>→</span>
                Measure
                <span>→</span>
                Discuss
                <span>→</span>
                Quote
                <span>→</span>
                Revise
              </div>

            </div>


            <div class="comparison-card featured">

              <span class="comparison-number">
                QuoteLens
              </span>

              <div class="comparison-flow">
                Specify
                <span>→</span>
                Discover
                <span>→</span>
                Compare
                <span>→</span>
                Enquire
              </div>

            </div>

          </div>

        </section>


        <!-- =================================================
             CATALOGUES
        ================================================== -->

        <section
          id="catalogues"
          class="catalogues-section"
        >

          <div class="section-heading">

            <div>

              <div class="section-label">
                Explore catalogues
              </div>

              <h2>
                Start with what
                <br />
                you're looking for.
              </h2>

            </div>

            <p>
              Interactive catalogues turn complicated
              custom products into guided buying experiences.
            </p>

          </div>


          <!--
            IMPORTANT:
            No new catalogue functionality is introduced here.

            The existing catalogue registry remains the source
            of truth and each catalogue keeps its existing
            demoUrl / join URL.
          -->

          <div class="catalogue-grid">

            {
              catalogues.map((catalogue, index) => (

                <a
                  href={catalogue.demoUrl}
                  class="catalogue-card"
                  style={`--accent:${catalogue.experience.color};`}
                >

                  <div class="catalogue-card-top">

                    <span class="catalogue-number">
                      {String(index + 1).padStart(2, "0")}
                    </span>

                    <span class="catalogue-category">
                      {catalogue.category}
                    </span>

                  </div>


                  <div class="catalogue-image">

                    {
                      catalogue.image ? (
                        <img
                          src={catalogue.image}
                          alt={catalogue.title}
                          loading="lazy"
                        />
                      ) : (
                        <div class="catalogue-placeholder">
                          <span>
                            {catalogue.experience.icon}
                          </span>
                        </div>
                      )
                    }

                    <div class="catalogue-accent">
                      {catalogue.experience.title}
                    </div>

                  </div>


                  <div class="catalogue-card-body">

                    <div>

                      <h3>
                        {catalogue.title}
                      </h3>

                      <p>
                        {catalogue.shortDescription}
                      </p>

                    </div>

                    <span class="catalogue-explore">
                      Explore
                      <span>→</span>
                    </span>

                  </div>

                </a>

              ))
            }

          </div>

        </section>


        <!-- =================================================
             HOW IT WORKS
        ================================================== -->

        <section
          id="how-it-works"
          class="how-section"
        >

          <div class="section-heading centered">

            <div class="section-label">
              How it works
            </div>

            <h2>
              Buying custom products
              <br />
              shouldn't feel complicated.
            </h2>

            <p>
              QuoteLens helps customers move from
              uncertainty to a prepared enquiry.
            </p>

          </div>


          <div class="steps-grid">

            <article class="step-card">

              <span class="step-icon">
                ⌕
              </span>

              <span class="step-number">
                01
              </span>

              <h3>
                Discover
              </h3>

              <p>
                Find a product or business that
                offers what you're looking for.
              </p>

            </article>


            <article class="step-card">

              <span class="step-icon">
                ◇
              </span>

              <span class="step-number">
                02
              </span>

              <h3>
                Configure
              </h3>

              <p>
                Give the information needed to
                understand your requirements.
              </p>

            </article>


            <article class="step-card">

              <span class="step-icon">
                ≋
              </span>

              <span class="step-number">
                03
              </span>

              <h3>
                Compare
              </h3>

              <p>
                Browse the products and options
                that match what you told us.
              </p>

            </article>


            <article class="step-card">

              <span class="step-icon">
                →
              </span>

              <span class="step-number">
                04
              </span>

              <h3>
                Enquire
              </h3>

              <p>
                Choose what you want and send the
                business a prepared enquiry.
              </p>

            </article>

          </div>

        </section>


        <!-- =================================================
             MARKETPLACE
        ================================================== -->

        <section
          id="marketplace"
          class="marketplace-section"
        >

          <div class="section-heading">

            <div>

              <div class="section-label">
                Marketplace
              </div>

              <h2>
                Find something
                <br />
                that fits.
              </h2>

            </div>

            <div class="marketplace-heading-side">

              <p>
                Browse products published by businesses
                and enter the buying experience directly.
              </p>

              <a href="/marketplace">
                Browse marketplace
                <span>→</span>
              </a>

            </div>

          </div>


          <div class="marketplace-preview">

            <article class="marketplace-item">

              <div class="marketplace-item-icon">
                🪟
              </div>

              <div class="marketplace-item-content">

                <span>
                  Home Improvement
                </span>

                <small>
                  Kui's Plantation Shutters
                </small>

                <h3>
                  Plantation Shutters
                </h3>

                <p>
                  Configure your window requirements
                  and compare available options.
                </p>

              </div>

              <a href="/marketplace">
                Configure product
                <span>→</span>
              </a>

            </article>


            <article class="marketplace-item">

              <div class="marketplace-item-icon">
                🔧
              </div>

              <div class="marketplace-item-content">

                <span>
                  Automotive
                </span>

                <small>
                  Published business catalogue
                </small>

                <h3>
                  Vehicle Parts
                </h3>

                <p>
                  Match a vehicle, model and part
                  before starting the conversation.
                </p>

              </div>

              <a href="/marketplace">
                Match a part
                <span>→</span>
              </a>

            </article>


            <article class="marketplace-item">

              <div class="marketplace-item-icon">
                🎂
              </div>

              <div class="marketplace-item-content">

                <span>
                  Food
                </span>

                <small>
                  Published business catalogue
                </small>

                <h3>
                  Custom Cakes
                </h3>

                <p>
                  Choose an occasion, explore designs
                  and prepare your enquiry.
                </p>

              </div>

              <a href="/marketplace">
                Explore options
                <span>→</span>
              </a>

            </article>

          </div>

        </section>


        <!-- =================================================
             BUSINESS SECTION
        ================================================== -->

        <section class="business-section">

          <div class="business-intro">

            <div class="section-label">
              For businesses
            </div>

            <h2>
              Turn your products
              <span>
                into structured
                buying experiences.
              </span>
            </h2>

            <p>
              Configure your products once. Give customers
              a better way to tell you what they need.
            </p>

            <a
              href="/join"
              class="business-button"
            >
              Publish your catalogue
              <span>→</span>
            </a>

          </div>


          <div class="business-points">

            <article>

              <span>01</span>

              <h3>
                Structured enquiries
              </h3>

              <p>
                Customers arrive with useful
                specifications already attached.
              </p>

            </article>


            <article>

              <span>02</span>

              <h3>
                Searchable products
              </h3>

              <p>
                Your catalogue becomes discoverable
                through the QuoteLens marketplace.
              </p>

            </article>


            <article>

              <span>03</span>

              <h3>
                Better conversations
              </h3>

              <p>
                Spend less time figuring out what
                the customer is actually asking for.
              </p>

            </article>

          </div>

        </section>


        <!-- =================================================
             COMMUNITY
        ================================================== -->

        <section class="community-section">

          <div class="section-label">
            Community validation
          </div>

          <h2>
            We're building this
            <br />
            with the people who will use it.
          </h2>

          <p>
            QuoteLens is exploring what happens when
            specification-driven buying comes to the
            fragmented world of custom and made-to-order
            products.
          </p>

          <div class="community-actions">

            <div class="community-question">
              <strong>
                Was QuoteLens useful?
              </strong>

              <span>
                Tell us what you think.
              </span>
            </div>

            <a href="/community">
              Share your experience
              <span>→</span>
            </a>

          </div>

        </section>


        <!-- =================================================
             FINAL CTA
        ================================================== -->

        <section class="final-cta">

          <div class="section-label">
            QuoteLens
          </div>

          <h2>
            Make the next enquiry
            <br />
            a better one.
          </h2>

          <p>
            Tell us what you need. Discover what fits.
            Start the right conversation.
          </p>

          <div class="final-actions">

            <a
              href="#catalogues"
              class="primary-button"
            >
              Explore products
              <span>→</span>
            </a>

            <a
              href="/join"
              class="secondary-button"
            >
              Publish your catalogue
            </a>

          </div>

        </section>


        <!-- =================================================
             FOOTER
        ================================================== -->

        <footer class="footer">

          <div class="footer-brand">

            <a href="/" class="brand">

              <span class="brand-mark">
                Q
              </span>

              <span>
                QuoteLens
              </span>

            </a>

            <p>
              Specification-driven buying for
              custom and made-to-order products.
            </p>

          </div>


          <div class="footer-column">

            <strong>
              Explore
            </strong>

            <a href="#catalogues">
              Catalogues
            </a>

            <a href="#how-it-works">
              How it works
            </a>

            <a href="#marketplace">
              Marketplace
            </a>

          </div>


          <div class="footer-column">

            <strong>
              For businesses
            </strong>

            <a href="/join">
              Publish
            </a>

            <a href="/signin">
              Sign in
            </a>

          </div>


          <div class="footer-column">

            <strong>
              Community
            </strong>

            <a href="/community">
              Community
            </a>

            <a href="/help">
              Help
            </a>

          </div>


          <div class="footer-bottom">

            <span>
              © 2026 QuoteLens
            </span>

            <span>
              Built for better buying
            </span>

          </div>

        </footer>

      </div>

    </main>

  </div>


  <!-- =======================================================
       STYLES
  ======================================================== -->

  <style>

    :global(*) {
      box-sizing: border-box;
    }

    :global(html) {
      scroll-behavior: smooth;
    }

    :global(body) {
      margin: 0;
      background: #f5f2ec;
      color: #191816;
      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    }

    :global(a) {
      color: inherit;
    }


    /* =====================================================
       HEADER
    ====================================================== */

    .site-header {
      position: sticky;
      top: 0;
      z-index: 100;

      height: 72px;

      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;

      padding: 0 5vw;

      border-bottom: 1px solid #ded9d0;

      background: rgba(245, 242, 236, 0.94);

      backdrop-filter: blur(14px);
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 10px;

      text-decoration: none;

      font-weight: 800;
      letter-spacing: -0.025em;
    }

    .brand-mark {
      width: 31px;
      height: 31px;

      display: grid;
      place-items: center;

      border-radius: 8px;

      background: #191816;
      color: white;

      font-size: 13px;
      font-weight: 900;
    }

    .brand-name {
      font-size: 17px;
    }

    .main-nav {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .main-nav a,
    .signin-link {
      color: #6d6962;

      text-decoration: none;

      font-size: 13px;
      font-weight: 600;

      transition:
        color 160ms ease;
    }

    .main-nav a:hover,
    .signin-link:hover {
      color: #191816;
    }

    .header-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 22px;
    }

    .publish-button {
      padding: 12px 19px;

      border-radius: 999px;

      background: #191816;
      color: white;

      text-decoration: none;

      font-size: 12px;
      font-weight: 750;
    }


    /* =====================================================
       MAIN LAYOUT
    ====================================================== */

    .main-layout {
      display: grid;
      grid-template-columns: minmax(330px, 0.82fr) minmax(0, 1.8fr);
      align-items: start;
    }

    .editorial-panel {
      position: sticky;
      top: 72px;

      height: calc(100vh - 72px);

      border-right: 1px solid #ded9d0;

      background:
        radial-gradient(
          circle at 0% 20%,
          rgba(184, 134, 42, 0.10),
          transparent 35%
        ),
        #f5f2ec;
    }

    .editorial-inner {
      min-height: 100%;

      display: flex;
      flex-direction: column;
      justify-content: center;

      padding:
        70px
        clamp(34px, 5vw, 80px);
    }

    .eyebrow,
    .section-label {
      color: #b27c1e;

      font-size: 11px;
      font-weight: 850;

      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .editorial-inner .eyebrow {
      margin-bottom: 28px;
    }

    .editorial-inner h1 {
      margin: 0;

      font-size: clamp(54px, 5.2vw, 82px);
      line-height: 0.9;

      letter-spacing: -0.065em;
    }

    .editorial-inner h1 span {
      color: #777269;
    }

    .editorial-inner h1 strong {
      display: block;

      margin-top: 3px;

      color: #191816;

      font-weight: inherit;
    }

    .hero-description {
      max-width: 500px;

      margin: 34px 0 27px;

      color: #666159;

      font-size: 16px;
      line-height: 1.7;
    }

    .hero-actions,
    .final-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .primary-button,
    .secondary-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 20px;

      min-height: 48px;

      padding: 0 20px;

      border-radius: 999px;

      text-decoration: none;

      font-size: 13px;
      font-weight: 750;
    }

    .primary-button {
      background: #191816;
      color: white;
    }

    .secondary-button {
      border: 1px solid #d8d1c7;
      color: #191816;
      background: transparent;
    }

    .hero-note {
      margin-top: 28px;

      color: #8c857b;

      font-size: 11px;
    }


    /* =====================================================
       CONTENT
    ====================================================== */

    .content-panel {
      min-width: 0;
      overflow: hidden;
    }

    section {
      scroll-margin-top: 100px;
    }


    /* =====================================================
       CUSTOMER JOURNEY
    ====================================================== */

    .journey-section {
      padding: 65px 5vw 55px;
    }

    .journey-window {
      overflow: hidden;

      border: 1px solid #ddd7cd;
      border-radius: 20px;

      background: #fffdfa;

      box-shadow:
        0 25px 70px rgba(35, 31, 25, 0.08);
    }

    .window-top {
      height: 44px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 0 18px;

      border-bottom: 1px solid #e8e2d8;
    }

    .window-dots {
      display: flex;
      gap: 5px;
    }

    .window-dots span {
      width: 6px;
      height: 6px;

      border-radius: 50%;

      background: #d7d1c7;
    }

    .window-label {
      color: #9a948a;

      font-size: 10px;
      font-weight: 700;
    }

    .journey-content {
      padding: 43px;
    }

    .journey-eyebrow {
      color: #8c857b;

      font-size: 10px;
      font-weight: 800;

      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .journey-content h2 {
      margin: 13px 0 30px;

      font-size: clamp(34px, 4vw, 56px);
      line-height: 0.94;

      letter-spacing: -0.055em;
    }

    .journey-steps {
      display: grid;
      grid-template-columns: repeat(4, 1fr);

      margin-bottom: 28px;
    }

    .journey-steps div {
      display: flex;
      flex-direction: column;
      gap: 4px;

      padding-right: 15px;

      border-top: 1px solid #ddd7cd;
      padding-top: 10px;
    }

    .journey-steps small {
      color: #a39b91;

      font-size: 9px;
    }

    .journey-steps span {
      font-size: 10px;
      font-weight: 750;
    }

    .journey-product {
      display: flex;
      align-items: center;

      padding: 15px;

      border: 1px solid #e4ded5;
      border-radius: 15px;

      background: #fff;
    }

    .journey-product-icon {
      width: 60px;
      height: 60px;

      display: grid;
      place-items: center;

      margin-right: 15px;

      border-radius: 12px;

      background: #e7e1d7;

      font-size: 25px;
    }

    .journey-product-copy {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .journey-product-copy small {
      color: #b27c1e;

      font-size: 9px;
      font-weight: 850;

      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .journey-product-copy strong {
      font-size: 15px;
    }

    .journey-product-copy span {
      color: #8b857d;
      font-size: 11px;
    }

    .journey-arrow {
      margin-left: auto;
      font-size: 18px;
    }

    .journey-specs {
      display: grid;
      grid-template-columns: repeat(3, 1fr);

      margin-top: 14px;

      border-top: 1px solid #e4ded5;
    }

    .journey-specs div {
      padding: 15px 0;
    }

    .journey-specs div + div {
      padding-left: 18px;
      border-left: 1px solid #e4ded5;
    }

    .journey-specs small {
      display: block;

      margin-bottom: 4px;

      color: #999187;

      font-size: 9px;
      font-weight: 750;

      text-transform: uppercase;
