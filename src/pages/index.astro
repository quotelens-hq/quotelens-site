      .signin-link:hover {
        color: var(--ink);
      }


      .header-cta {

        padding:
          10px 16px;

        border:
          1px solid var(--ink);

        border-radius: 999px;

        background: var(--ink);

        color: #fff;

        text-decoration: none;

        font-size: 12px;

        font-weight: 700;

      }


      /* =====================================================
         HERO
      ====================================================== */

      .hero {

        position: relative;

        overflow: hidden;

        min-height: 680px;

        display: flex;

        align-items: center;

        background:
          linear-gradient(
            135deg,
            #fffaf4 0%,
            #f7f4ef 60%,
            #eee9e1 100%
          );

        border-bottom:
          1px solid var(--line);

      }


      .hero-inner {

        position: relative;

        z-index: 2;

        width:
          min(1180px, calc(100% - 48px));

        margin: 0 auto;

        padding:
          90px 0;

        display: grid;

        grid-template-columns:
          minmax(0, 1.05fr)
          minmax(420px, .95fr);

        align-items: center;

        gap: 80px;

      }


      .hero-glow {

        position: absolute;

        width: 500px;

        height: 500px;

        border-radius: 50%;

        filter: blur(90px);

        opacity: .22;

      }


      .hero-glow-one {

        top: -220px;

        left: -150px;

        background: #e9c98b;

      }


      .hero-glow-two {

        right: -180px;

        bottom: -260px;

        background: #d7d0c3;

      }


      .eyebrow,
      .section-eyebrow {

        display: flex;

        align-items: center;

        gap: 9px;

        color: var(--gold);

        font-size: 11px;

        font-weight: 800;

        letter-spacing: .12em;

      }


      .eyebrow-dot {

        width: 7px;

        height: 7px;

        border-radius: 50%;

        background: var(--gold);

      }


      .hero h1 {

        max-width: 720px;

        margin: 20px 0 0;

        font-size:
          clamp(48px, 6vw, 82px);

        line-height: .96;

        letter-spacing: -.065em;

        font-weight: 800;

      }


      .hero h1 span {

        display: block;

        color: #777066;

      }


      .hero-description {

        max-width: 620px;

        margin: 26px 0 0;

        color: var(--muted);

        font-size: 17px;

        line-height: 1.75;

      }


      .hero-actions {

        display: flex;

        align-items: center;

        flex-wrap: wrap;

        gap: 12px;

        margin-top: 34px;

      }


      .primary-button,
      .secondary-button {

        min-height: 48px;

        padding:
          0 20px;

        display: inline-flex;

        align-items: center;

        justify-content: center;

        gap: 22px;

        border-radius: 999px;

        text-decoration: none;

        font-size: 13px;

        font-weight: 750;

      }


      .primary-button {

        background: var(--ink);

        color: #fff;

      }


      .secondary-button {

        border:
          1px solid #d7d0c6;

        background:
          rgba(255,255,255,.45);

      }


      .hero-note {

        display: flex;

        align-items: center;

        gap: 10px;

        margin-top: 28px;

        color: var(--soft);

        font-size: 11px;

      }


      .note-line {

        width: 28px;

        height: 1px;

        background: #cfc8be;

      }


      /* HERO VISUAL */

      .hero-visual {
        perspective: 1000px;
      }


      .visual-window {

        overflow: hidden;

        border:
          1px solid rgba(26,25,22,.12);

        border-radius: 20px;

        background: rgba(255,255,255,.74);

        box-shadow:
          0 30px 70px rgba(45,39,31,.13);

        transform:
          rotateY(-4deg)
          rotateX(2deg);

      }


      .window-top {

        height: 48px;

        padding:
          0 18px;

        display: flex;

        align-items: center;

        justify-content: space-between;

        border-bottom:
          1px solid var(--line);

        color: var(--soft);

        font-size: 10px;

        font-weight: 700;

        letter-spacing: .08em;

      }


      .window-dots {

        display: flex;

        gap: 5px;

      }


      .window-dots span {

        width: 6px;

        height: 6px;

        border-radius: 50%;

        background: #d5cec4;

      }


      .visual-content {
        padding: 34px;
      }


      .visual-label {

        color: var(--soft);

        font-size: 9px;

        font-weight: 800;

        letter-spacing: .13em;

      }


      .visual-title {

        margin-top: 12px;

        font-size: 34px;

        line-height: 1;

        font-weight: 800;

        letter-spacing: -.05em;

      }


      .visual-progress {

        margin-top: 34px;

        display: flex;

        align-items: center;

      }


      .progress-item {

        color: #aaa297;

        font-size: 9px;

        font-weight: 700;

      }


      .progress-item span {

        display: block;

        margin-bottom: 5px;

        font-size: 8px;

      }


      .progress-item.active {

        color: var(--ink);

      }


      .progress-line {

        flex: 1;

        height: 1px;

        margin:
          0 8px;

        background: #ddd7ce;

      }


      .visual-product {

        margin-top: 36px;

        padding: 12px;

        display: flex;

        align-items: center;

        gap: 14px;

        border:
          1px solid var(--line);

        border-radius: 13px;

        background: #fff;

      }


      .product-image {

        width: 70px;

        height: 70px;

        display: grid;

        place-items: center;

        border-radius: 10px;

        background:
          linear-gradient(
            135deg,
            #e8e2d9,
            #d7d0c5
          );

        font-size: 27px;

      }


      .product-info {

        flex: 1;

        display: flex;

        flex-direction: column;

        gap: 5px;

      }


      .product-category {

        color: var(--gold);

        font-size: 8px;

        font-weight: 800;

        letter-spacing: .1em;

      }


      .product-info strong {
        font-size: 14px;
      }


      .product-info > span:last-child {

        color: var(--soft);

        font-size: 10px;

      }


      .product-arrow {

        color: var(--soft);

        font-size: 18px;

      }


      /* =====================================================
         GENERAL SECTIONS
      ====================================================== */

      .section-container {

        width:
          min(1180px, calc(100% - 48px));

        margin: 0 auto;

      }


      .catalogues-section,
      .how-section,
      .marketplace-section {

        padding:
          110px 0;

      }


      .section-heading {

        display: grid;

        grid-template-columns:
          minmax(0, 1fr)
          minmax(280px, .5fr);

        gap: 60px;

        align-items: end;

      }


      .section-heading.centered {

        grid-template-columns:
          minmax(0, 800px);

        justify-content: center;

        text-align: center;

      }


      .section-heading.centered
      .section-eyebrow {

        justify-content: center;

      }


      .section-heading h2,
      .marketplace-header h2 {

        max-width: 700px;

        margin: 16px 0 0;

        font-size:
          clamp(38px, 5vw, 60px);

        line-height: 1;

        letter-spacing: -.055em;

      }


      .section-heading p,
      .marketplace-header p {

        margin: 0;

        color: var(--muted);

        font-size: 15px;

        line-height: 1.7;

      }


      /* =====================================================
         SEARCH
      ====================================================== */

      .catalogue-search {

        margin-top: 50px;

        display: flex;

        align-items: center;

        gap: 13px;

        height: 58px;

        padding:
          0 18px;

        border:
          1px solid var(--line);

        border-radius: 14px;

        background: var(--paper);

      }


      .search-icon {

        color: var(--soft);

        font-size: 23px;

      }


      .catalogue-search input {

        flex: 1;

        min-width: 0;

        border: 0;

        outline: 0;

        background: transparent;

        color: var(--ink);

        font-size: 14px;

      }


      .catalogue-search input::placeholder {
        color: #aaa298;
      }


      .search-hint {

        color: var(--soft);

        font-size: 10px;

        font-weight: 700;

      }


      .category-filter {

        display: flex;

        gap: 8px;

        overflow-x: auto;

        padding: 18px 0 0;

      }


      .filter-button {

        flex: 0 0 auto;

        padding:
          8px 13px;

        border:
          1px solid var(--line);

        border-radius: 999px;

        background: transparent;

        color: var(--muted);

        cursor: pointer;

        font-size: 11px;

        font-weight: 700;

      }


      .filter-button.active {

        border-color: var(--ink);

        background: var(--ink);

        color: #fff;

      }


      /* =====================================================
         CATALOGUE CARDS
      ====================================================== */

      .catalogue-grid {

        display: grid;

        grid-template-columns:
          repeat(3, minmax(0, 1fr));

        gap: 22px;

        margin-top: 32px;

      }


      .catalogue-card {

        overflow: hidden;

        border:
          1px solid var(--line);

        border-radius: 18px;

        background: var(--paper);

        transition:
          transform .25s ease,
          box-shadow .25s ease;

      }


      .catalogue-card:hover {

        transform:
          translateY(-4px);

        box-shadow:
          0 18px 45px rgba(40,35,29,.09);

      }


      .catalogue-card.hidden,
      .marketplace-card.hidden {

        display: none;

      }


      .catalogue-preview {

        position: relative;

        height: 230px;

        overflow: hidden;

        background:
          linear-gradient(
            135deg,
            #eee8df,
            #dcd5ca
          );

      }


      .catalogue-preview img {

        width: 100%;

        height: 100%;

        display: block;

        object-fit: cover;

      }


      .catalogue-placeholder {

        width: 100%;

        height: 100%;

        display: grid;

        place-items: center;

        background:
          linear-gradient(
            135deg,
            #f0ebe4,
            #ddd6cc
          );

        font-size: 48px;

      }


      .preview-overlay {

        position: absolute;

        inset: 0;

        background:
          linear-gradient(
            to top,
            rgba(20,18,15,.52),
            transparent 55%
          );

      }


      .preview-caption {

        position: absolute;

        left: 16px;

        bottom: 14px;

        display: flex;

        align-items: center;

        gap: 7px;

        color: #fff;

        font-size: 10px;

        font-weight: 700;

      }


      .preview-dot {

        width: 6px;

        height: 6px;

        border-radius: 50%;

        background: var(--accent);

      }


      .catalogue-card-body {

        padding: 22px;

      }


      .experience-badge {

        display: inline-flex;

        align-items: center;

        gap: 6px;

        color: var(--accent);

        font-size: 10px;

        font-weight: 800;

      }


      .catalogue-card h3 {

        margin:
          13px 0 8px;

        font-size: 23px;

        line-height: 1.05;

        letter-spacing: -.035em;

      }


      .catalogue-card p {

        min-height: 48px;

        margin: 0;

        color: var(--muted);

        font-size: 12px;

        line-height: 1.6;

      }


      .card-divider {

        height: 1px;

        margin:
          19px 0 15px;

        background: var(--line);

      }


      .card-flow {

        display: flex;

        flex-direction: column;

        gap: 8px;

        margin: 0;

        padding: 0;

        list-style: none;

      }


      .card-flow li {

        display: flex;

        align-items: center;

        gap: 8px;

        color: var(--muted);

        font-size: 11px;

      }


      .flow-check {

        color: var(--accent);

        font-weight: 800;

      }


      .catalogue-card-link {

        display: flex;

        align-items: center;

        justify-content: space-between;

        margin-top: 21px;

        padding-top: 16px;

        border-top:
          1px solid var(--line);

        color: var(--accent);

        text-decoration: none;

        font-size: 11px;

        font-weight: 800;

      }


      .catalogue-empty {

        display: none;

        padding: 45px 0;

        text-align: center;

        color: var(--muted);

        font-size: 13px;

      }


      .catalogue-empty.visible {
        display: block;
      }


      .catalogue-empty button {

        margin-left: 8px;

        padding: 0;

        border: 0;

        background: transparent;

        color: var(--gold);

        cursor: pointer;

        font-weight: 800;

      }


      /* =====================================================
         HOW IT WORKS
      ====================================================== */

      .how-section {

        background: #eeebe5;

        border-top:
          1px solid var(--line);

        border-bottom:
          1px solid var(--line);

      }


      .journey-grid {

        display: grid;

        grid-template-columns:
          repeat(4, 1fr);

        gap: 1px;

        margin-top: 58px;

        border:
          1px solid #ddd7ce;

        background: #ddd7ce;

      }


      .journey-card {

        position: relative;

        min-height: 250px;

        padding: 28px;

        background: #f7f4ef;

      }


      .journey-number {

        position: absolute;

        top: 25px;

        right: 25px;

        color: #b0a89d;

        font-size: 10px;

        font-weight: 800;

      }


      .journey-icon {

        width: 48px;

        height: 48px;

        display: grid;

        place-items: center;

        margin-bottom: 55px;

        border:
          1px solid #d8d1c7;

        border-radius: 12px;

        background: #fffdf9;

        font-size: 20px;

      }


      .journey-card h3 {

        margin: 0 0 8px;

        font-size: 21px;

        letter-spacing: -.03em;

      }


      .journey-card p {

        max-width: 220px;

        margin: 0;

        color: var(--muted);

        font-size: 12px;

        line-height: 1.65;

      }


      /* BUSINESS */

      .business-story {

        margin-top: 80px;

        padding: 55px;

        display: grid;

        grid-template-columns:
          .9fr 1.1fr;

        gap: 70px;

        align-items: center;

        border-radius: 20px;

        background: var(--ink);

        color: #fff;

      }


      .business-story .section-eyebrow {
        color: #d0a64e;
      }


      .business-copy h3 {

        max-width: 540px;

        margin:
          14px 0 17px;

        font-size:
          clamp(32px, 4vw, 49px);

        line-height: 1;

        letter-spacing: -.05em;

      }


      .business-copy p {

        max-width: 500px;

        margin: 0;

        color: #b8b2a9;

        font-size: 14px;

        line-height: 1.7;

      }


      .business-button {

        display: inline-flex;

        align-items: center;

        gap: 22px;

        margin-top: 28px;

        padding:
          13px 17px;

        border-radius: 999px;

        background: #fff;

        color: var(--ink);

        text-decoration: none;

        font-size: 11px;

        font-weight: 800;

      }


      .business-flow {

        display: flex;

        align-items: center;

        gap: 12px;

      }


      .business-flow-item {

        flex: 1;

        min-height: 120px;

        padding: 18px;

        display: flex;

        flex-direction: column;

        justify-content: space-between;

        border:
          1px solid rgba(255,255,255,.12);

        border-radius: 12px;

        color: #e7e2da;

        font-size: 12px;

      }


      .business-flow-item span {

        color: #8d877e;

        font-size: 9px;

        font-weight: 800;

      }


      .business-flow-arrow {

        color: #706b64;

      }


      /* =====================================================
         MARKETPLACE
      ====================================================== */

      .marketplace-section {

        background: #fffdf9;

      }


      .marketplace-header {

        display: flex;

        align-items: end;

        justify-content: space-between;

        gap: 40px;

      }


      .marketplace-header p {

        max-width: 430px;

        margin-top: 18px;

      }


      .marketplace-link {

        flex: 0 0 auto;

        display: inline-flex;

        align-items: center;

        gap: 15px;

        color: var(--ink);

        text-decoration: none;

        font-size: 12px;

        font-weight: 800;

      }


      .marketplace-grid {

        display: grid;

        grid-template-columns:
          repeat(3, 1fr);

        gap: 18px;

        margin-top: 55px;

      }


      .marketplace-card {

        display: block;

        overflow: hidden;

        border:
          1px solid var(--line);

        border-radius: 16px;

        background: #fff;

        text-decoration: none;

        color: inherit;

        transition:
          transform .2s ease,
          box-shadow .2s ease;

      }


      .marketplace-card:hover {

        transform:
          translateY(-3px);

        box-shadow:
          0 15px 40px rgba(40,35,29,.08);

      }


      .marketplace-image {

        height: 200px;

        overflow: hidden;

        background: #eee9e1;

      }


      .marketplace-image img {

        width: 100%;

        height: 100%;

        object-fit: cover;

        display: block;

      }


      .marketplace-card-body {

        padding: 20px;

      }


      .marketplace-business {

        display: inline-flex;

        align-items: center;

        gap: 6px;

        color: var(--soft);

        font-size: 9px;

        font-weight: 800;

        letter-spacing: .07em;
        text-transform: uppercase;

      }


      .demo-tag {

        font-size: 8px;

        font-weight: 800;

        letter-spacing: .03em;

        color: #fff;

        background: var(--soft);

        padding: 2px 6px;

        border-radius: 4px;

      }


      .marketplace-dimension {

        margin: 6px 0 0;

        color: var(--muted);

        font-size: 11px;

      }


      .marketplace-card h3 {

        margin:
          10px 0 5px;

        font-size: 20px;

        letter-spacing: -.03em;

      }


      .marketplace-card p {

        margin: 0;

        color: var(--muted);

        font-size: 12px;

        line-height: 1.6;

      }


      .marketplace-price {

        margin-top: 10px !important;

        color: var(--gold) !important;

        font-size: 16px !important;

        font-weight: 800 !important;

      }


      .marketplace-action {

        display: flex;

        align-items: center;

        justify-content: space-between;

        margin-top: 18px;

        padding-top: 15px;

        border-top:
          1px solid var(--line);

        color: var(--accent);

        text-decoration: none;

        font-size: 11px;

        font-weight: 800;

      }


      /* =====================================================
         FINAL CTA
      ====================================================== */

      .final-cta {

        padding:
          100px 0;

        background:
          linear-gradient(
            135deg,
            #f0e8d9,
            #e6ddd0
          );

        border-top:
          1px solid var(--line);

      }


      .cta-inner {

        width:
          min(1000px, calc(100% - 48px));

        margin: 0 auto;

        display: flex;

        align-items: end;

        justify-content: space-between;

        gap: 50px;

      }


      .cta-copy h2 {

        max-width: 650px;

        margin:
          14px 0;

        font-size:
          clamp(38px, 5vw, 62px);

        line-height: .98;

        letter-spacing: -.055em;

      }


      .cta-copy p {

        max-width: 550px;

        margin: 0;

        color: var(--muted);

        font-size: 14px;

        line-height: 1.7;

      }


      .cta-button {

        flex: 0 0 auto;

        display: inline-flex;

        align-items: center;

        gap: 25px;

        padding:
          15px 20px;

        border-radius: 999px;

        background: var(--ink);

        color: #fff;

        text-decoration: none;

        font-size: 12px;

        font-weight: 800;

      }


      /* =====================================================
         FOOTER
      ====================================================== */

      .site-footer {

        background: #1a1916;

        color: #fff;

      }


      .footer-inner {

        width:
          min(1180px, calc(100% - 48px));

        margin: 0 auto;

        padding:
          70px 0 55px;

        display: grid;

        grid-template-columns:
          2fr 1fr 1fr 1fr;

        gap: 50px;

      }


      .footer-brand p {

        margin-top: 17px;

        color: #88827a;

        font-size: 11px;

      }


      .footer-column {

        display: flex;

        flex-direction: column;

        gap: 11px;

      }


      .footer-column strong {

        margin-bottom: 5px;

        color: #fff;

        font-size: 11px;

      }


      .footer-column a {

        color: #89837b;

        text-decoration: none;

        font-size: 11px;

      }


      .footer-column a:hover {
        color: #fff;
      }


      .footer-bottom {

        width:
          min(1180px, calc(100% - 48px));

        margin: 0 auto;

        padding:
          20px 0;

        display: flex;

        justify-content: space-between;

        gap: 20px;

        border-top:
          1px solid rgba(255,255,255,.09);

        color: #706b64;

        font-size: 10px;

      }


      /* =====================================================
         RESPONSIVE
      ====================================================== */

      @media (max-width: 950px) {

        .hero-inner {

          grid-template-columns: 1fr;

          gap: 55px;

        }


        .hero {

          min-height: auto;

        }


        .hero-visual {

          max-width: 650px;

        }


        .catalogue-grid,
        .marketplace-grid {

          grid-template-columns:
            repeat(2, minmax(0, 1fr));

        }


        .journey-grid {

          grid-template-columns:
            repeat(2, 1fr);

        }


        .business-story {

          grid-template-columns: 1fr;

        }


        .footer-inner {

          grid-template-columns:
            2fr 1fr 1fr;

        }

      }


      @media (max-width: 700px) {

        .header-inner,
        .hero-inner,
        .section-container,
        .footer-inner,
        .footer-bottom,
        .cta-inner {

          width:
            min(100% - 30px, 1180px);

        }


        .main-nav {
          display: none;
        }


        .header-cta {
          font-size: 10px;
          padding: 9px 12px;
        }


        .hero-inner {

          padding:
            65px 0 75px;

        }


        .hero h1 {
          font-size: 48px;
        }


        .hero-description {
          font-size: 15px;
        }


        .catalogues-section,
        .how-section,
        .marketplace-section {

          padding:
            75px 0;

        }


        .section-heading {

          grid-template-columns: 1fr;

          gap: 20px;

        }


        .section-heading h2,
        .marketplace-header h2 {

          font-size: 40px;

        }


        .catalogue-grid,
        .marketplace-grid {

          grid-template-columns: 1fr;

        }


        .journey-grid {

          grid-template-columns: 1fr;

        }


        .journey-card {
          min-height: 220px;
        }


