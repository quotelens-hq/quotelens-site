---
import Layout from '../layouts/Layout.astro'
---
<Layout>

  <!-- ── 1. THE PROMISE + THE FLOW ──────────────────────── -->
  <section id="promise" style="text-align:center; padding-top: 110px;">
    <p class="eyebrow">QuoteLens</p>
    <h1>"How much?"<br />finally has an answer.</h1>
    <p style="margin-top:18px; font-size:1.2rem; max-width:580px; margin-left:auto; margin-right:auto;">
      Photo, measurements, materials, price — your customers answer it
      themselves, before anyone lifts a tape measure.
    </p>

    <div class="journey">
      <div class="journey-step">Customer sees your advert</div>
      <div class="journey-arrow">↓</div>
      <div class="journey-step">Photographs their opening</div>
      <div class="journey-arrow">↓</div>
      <div class="journey-step">Confirms measurements</div>
      <div class="journey-arrow">↓</div>
      <div class="journey-step">Explores your products</div>
      <div class="journey-arrow">↓</div>
      <div class="journey-step gold">Gets their price</div>
    </div>

    <p class="timer">⏱ 4 minutes 18 seconds</p>

    <div style="margin-top:34px; display:flex; gap:14px; justify-content:center; flex-wrap:wrap;">
      <a class="btn btn-primary" href="/join">Start Free</a>
      <a class="btn btn-ghost" href="#salesperson">Watch Demo</a>
    </div>
  </section>

  <!-- ── 2. THE PROBLEM ─────────────────────────────────── -->
  <section id="problem" style="text-align:center;">
    <p class="eyebrow">The Problem</p>
    <h2>Every enquiry starts with "How much?"<br />
        Every answer starts with "What size?"</h2>
    <p style="margin-top:14px; max-width:560px; margin-left:auto; margin-right:auto;">
      Curtains, doors, gates, kitchens — for fabricators and installers,
      no price exists until someone measures. And that translates to:
    </p>

   <div class="mirror-cards">
      <div class="pain-card">
        <span>🚗</span>
        <p>Drive 40 minutes.<br />Customer says,<br />"I was just asking."</p>
      </div>
      <div class="pain-card">
        <span>📞</span>
        <p>Answer the same WhatsApp<br />27 times today.</p>
      </div>
      <div class="pain-card">
        <span>📍</span>
        <p>Lose customers because<br />they're outside your area.</p>
      </div>
    </div>
  </section>

  <!-- ── 3. WITH QUOTELENS — the mirror ─────────────────── -->
  <section id="salesperson" style="text-align:center;">
    <p class="eyebrow">With QuoteLens</p>

   <div class="mirror-cards">
      <div class="answer-card">
        <span>✓</span>
        <p>Visit customers who are ready.</p>
      </div>
      <div class="answer-card">
        <span>⚡</span>
        <p>Every enquiry answered instantly.</p>
      </div>
      <div class="answer-card">
        <span>🌍</span>
        <p>Quote customers anywhere.</p>
      </div>
    </div>

    <p class="objection">
      Every business sells differently — your products, your materials,
      your prices. <strong>QuoteLens quotes the way you do.</strong>
    </p>

    <h2 style="margin-top:34px;">That's your Virtual Salesperson.</h2>

    <!-- Demo slot — recordings drop in here -->
    <div class="media-slot">Watch it working — demos coming</div>
  </section>

  <!-- ── 4. THE DECISION (dark band, no button) ─────────── -->
  <div class="final-band">
    <p>Your customers are already asking "How much?"<br />
       Give them an instant answer.</p>
    <p class="hire-line">Hire your first Virtual Salesperson.</p>
  </div>

  <!-- ── 5. PRICING (the action) ────────────────────────── -->
  <section id="pricing" style="text-align:center; padding-top:64px;">
    <div class="price-card">
      <p class="price">$49<span>/month</span></p>
      <ul>
        <li>Unlimited quotes & enquiries</li>
        <li>Unlimited products</li>
        <li>500 AI credits monthly</li>
        <li>WhatsApp & email delivery</li>
        <li>Business dashboard</li>
      </ul>
      <a class="btn btn-primary" href="/join" style="width:100%; text-align:center;">Create Your QuoteLens</a>
    </div>

    <p style="margin-top:16px; font-weight:600; color:var(--gold-dark);">
      Less than the cost of one unnecessary site visit.
    </p>

    <p class="trust-strip">
      Works on WhatsApp · No technical skills needed · Free to start
    </p>
  </section>

</Layout>

<style>
  .journey {
    margin: 44px auto 0;
    max-width: 380px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .journey-step {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 18px;
    font-weight: 600;
    font-size: 0.98rem;
  }
  .journey-step.gold {
    background: var(--gold-pale);
    border-color: var(--gold);
    color: var(--gold-dark);
  }
  .journey-arrow { color: var(--gold); font-weight: 700; }
  .timer {
    margin-top: 26px;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--gold-dark);
  }

  /* Shared grid so problem and answer sections rhyme visually */
  .mirror-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 14px;
    margin-top: 40px;
  }

  /* Pains: muted, grey-toned — the "before" */
  .pain-card {
    background: #f4f2ee;
    border: 1px solid #e4e0d8;
    border-radius: var(--radius);
    padding: 26px 18px;
  }
  .pain-card span { font-size: 1.8rem; display: block; margin-bottom: 10px; filter: grayscale(0.6); }
  .pain-card p { font-weight: 600; color: var(--ink-soft); font-size: 1rem; }

  /* Answers: warm gold — the "after", same shape transformed */
  .answer-card {
    background: var(--gold-pale);
    border: 1px solid var(--gold);
    border-radius: var(--radius);
    padding: 26px 18px;
  }
  .answer-card span { font-size: 1.8rem; display: block; margin-bottom: 10px; }
  .answer-card p { font-weight: 700; color: var(--gold-dark); font-size: 1rem; }

  .objection {
    margin: 36px auto 0;
    max-width: 540px;
    font-size: 1.05rem;
    color: var(--ink-soft);
  }
  .objection strong { color: var(--ink); }

  .media-slot {
    margin: 38px auto 0;
    max-width: 640px;
    aspect-ratio: 16 / 9;
    border: 2px dashed var(--border);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-faint);
    font-weight: 600;
  }

  .final-band {
    background: var(--ink);
    text-align: center;
    padding: 74px 20px 66px;
    margin-top: 60px;
  }
  .final-band p {
    color: #fff;
    font-size: clamp(1.2rem, 3.5vw, 1.7rem);
    font-weight: 700;
    margin-bottom: 14px;
  }
  .final-band .hire-line {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--gold-pale);
    margin-bottom: 0;
  }

  .price-card {
    margin: 0 auto;
    max-width: 360px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 30px 26px;
    text-align: left;
  }
  .price { font-size: 2.6rem; font-weight: 800; color: var(--ink); text-align: center; }
  .price span { font-size: 1rem; font-weight: 600; color: var(--ink-faint); }
  .price-card ul { list-style: none; margin: 20px 0 24px; }
  .price-card li {
    padding: 7px 0;
    color: var(--ink-soft);
    border-bottom: 1px solid var(--border);
    font-size: 0.97rem;
  }
  .price-card li::before { content: "✓ "; color: var(--gold); font-weight: 700; }

  .trust-strip {
    margin-top: 28px;
    font-size: 0.88rem;
    color: var(--ink-faint);
    letter-spacing: 0.02em;
  }
</style>